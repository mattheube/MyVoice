<UserControl x:Class="MyVoice.App.Views.MicrophoneView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:visual="clr-namespace:MyVoice.App.Services">

<StackPanel>

 <TextBlock Text="01 / VOICE CHANNEL" Style="{StaticResource Label}"/><DockPanel Margin="0,0,0,15"><TextBlock Text="{Binding T[Voice]}" Style="{StaticResource Heading}"/><Button Content="{Binding T[Routing]}" Command="{Binding ShowRoutingCommand}" HorizontalAlignment="Right"/></DockPanel>

 <Border Style="{StaticResource Card}" Background="#292A2C"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,25,0"><TextBlock Text="{Binding T[Input]}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}" AutomationProperties.Name="Microphone"/><TextBlock Text="{Binding MicState}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="LIVE INPUT" Style="{StaticResource Label}"/><TextBlock Text="48 kHz" HorizontalAlignment="Right" Style="{StaticResource Label}"/></DockPanel><visual:SignalHistory Level="{Binding Meter}" Height="65"/><TextBlock Text="{Binding LevelText}" FontFamily="Consolas" FontSize="10" Foreground="#AAA69B" Margin="0,8,0,0"/><TextBlock Text="{Binding T[Clip]}" Foreground="#EF8A75" FontSize="10" Visibility="{Binding Clipping,Converter={StaticResource BoolVisibility}}"/></StackPanel></Grid></Border>

 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>

  <StackPanel Margin="0,8,20,0"><DockPanel><TextBlock Text="{Binding T[Presets]}" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="{Binding T[VoiceEnabled]}" IsChecked="{Binding VoiceEnabled}" HorizontalAlignment="Right" Margin="0"/></DockPanel>

   <DockPanel Margin="0,10,0,0"><CheckBox DockPanel.Dock="Right" Content="{Binding T[FavoritesOnly]}" IsChecked="{Binding FavoritesOnly}" Margin="12,0,0,0"/><TextBox Text="{Binding VoiceSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding T[SearchVoice]}" AutomationProperties.Name="Search voices" Margin="0"/></DockPanel><ItemsControl ItemsSource="{Binding PresetView}" Margin="0,16,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="158" Height="138" Padding="14,12" Margin="0,0,10,10" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#524634"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="126"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><DockPanel><Path Data="{Binding Icon}" Width="36" Height="36" Stroke="#D7AB6C" StrokeThickness="1.6" Stretch="Uniform"/><TextBlock Text="✓" FontSize="12" Foreground="#E0AD62" Visibility="{Binding Selected,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Category}" FontSize="8" Foreground="#8E8B83" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="10" Foreground="#A5A29A" VerticalAlignment="Bottom"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

   <Border Background="#252627" Padding="12" BorderBrush="#3B3A35" BorderThickness="1"><DockPanel><TextBlock Text="{Binding CurrentPresetDisplay}" FontSize="14" Foreground="#E0AD62" VerticalAlignment="Center"/><CheckBox Content="{Binding T[Favorite]}" IsChecked="{Binding FavoritePreset}" HorizontalAlignment="Right"/></DockPanel></Border>

   <TextBlock Text="{Binding T[Intensity]}" Style="{StaticResource MutedText}"/><Slider Minimum="0" Maximum="100" Value="{Binding VoiceIntensity}" AutomationProperties.Name="Voice intensity"/>

  </StackPanel>

  <StackPanel Grid.Column="1" Margin="0,8,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[Gain]}" FontWeight="SemiBold"/><TextBlock Text="{Binding GainLabel}" Foreground="#E0AD62" FontFamily="Consolas" FontSize="17" Margin="0,14,0,4"/><Slider Minimum="-20" Maximum="30" Value="{Binding GainDb}" AutomationProperties.Name="Microphone gain"/><TextBlock Text="{Binding T[Recommended]}" Style="{StaticResource MutedText}"/><Button Content="{Binding T[Restore]}" Command="{Binding RestoreCommand}" FontSize="11"/><Border Height="1" Background="#40403D" Margin="0,16"/><TextBlock Text="{Binding T[MonitoringVolume]}" FontSize="12"/><Slider Value="{Binding MonitoringVolumeSlider}" Minimum="0" Maximum="200" AutomationProperties.Name="Monitoring volume"/><TextBlock Text="{Binding T[HeadphoneHint]}" Style="{StaticResource MutedText}"/></StackPanel></Border>

  <Expander Header="{Binding T[Calibrate]}"><StackPanel><TextBlock Text="{Binding T[CalibrationHelp]}" Style="{StaticResource MutedText}"/><Button Content="{Binding T[Calibrate]}" Command="{Binding CalibrateCommand}"/><ProgressBar IsIndeterminate="True" Visibility="{Binding Calibrating,Converter={StaticResource BoolVisibility}}" Margin="0,8"/><TextBlock Text="{Binding CalibrationText}" Style="{StaticResource MutedText}"/><WrapPanel Visibility="{Binding CanApply,Converter={StaticResource BoolVisibility}}"><Button Content="{Binding T[Apply]}" Command="{Binding ApplyCalibrationCommand}"/><Button Content="{Binding T[Keep]}" Command="{Binding KeepCalibrationCommand}"/></WrapPanel></StackPanel></Expander>

 </StackPanel></Grid>

<TextBlock Text="AI Voices" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,14"/><ItemsControl ItemsSource="{Binding AiVoices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="178" Height="140" Margin="0,0,14,14" Command="{Binding DataContext.UseAiVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding Ready}"><StackPanel><Grid Height="66"><Ellipse Width="60" Height="60" Fill="#514838"/><TextBlock Text="AI" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E0AD62" FontSize="20"/><ui:CoverImage Circular="True" Source="{Binding Cover}" Width="60" Height="60" Stretch="UniformToFill"/></Grid><TextBlock Text="{Binding Name}" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#AAA49A" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></UserControl>



