<UserControl x:Class="MyVoice.App.Views.NowPlayingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,24"><DockPanel><TextBlock Text="{Binding DataContext.T[Ui574],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}" VerticalAlignment="Center"/><Button Content="×" Command="{Binding ClosePlayerCommand}" HorizontalAlignment="Right" Padding="8,2"/></DockPanel><Border Background="{DynamicResource AccentSoftBrush}" Height="190" Width="190" Margin="0,20,0,16"><Grid><TextBlock Text="{Binding SelectedSound.Initial}" FontSize="70" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage ui:MediaDrop.ImageTarget="sound" FilePath="{Binding SelectedSound.Cover}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding SelectedSound.Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedSound.Folder}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedSound.Creator}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SoundState}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,10,0,8"/><Slider Value="{Binding SoundPosition}" Minimum="0" Maximum="{Binding SoundDuration}" AutomationProperties.Name="Playback position"/><TextBlock Text="{Binding SoundTime}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><WrapPanel Margin="0,14,0,12"><Button Content="↺" Command="{Binding RestartSoundCommand}" ToolTip="{Binding DataContext.T[Ui589],RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="▶ / Ⅱ" Command="{Binding PauseSoundCommand}" ToolTip="{Binding DataContext.T[Ui582],RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="■" Command="{Binding StopSoundCommand}" ToolTip="{Binding DataContext.T[Ui595],RelativeSource={RelativeSource AncestorType=Window}}"/></WrapPanel><CheckBox Content="{Binding DataContext.T[Ui564],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SoundLoop}"/><CheckBox Content="{Binding T[HearSound]}" IsChecked="{Binding SoundHear}"/><CheckBox Content="{Binding T[SendSound]}" IsChecked="{Binding SoundSend}"/><Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,15"/><TextBlock Text="{Binding T[Volume]}"/><Slider Value="{Binding SoundVolumeSlider}" Minimum="0" Maximum="400" AutomationProperties.Name="Sound volume"/><DockPanel><TextBlock Text="Volume (%)" VerticalAlignment="Center"/><TextBox Width="85" Text="{Binding SoundVolume,StringFormat=F0,ValidatesOnExceptions=True}"/></DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DataContext.T[Ui405],RelativeSource={RelativeSource AncestorType=Window}}"/><ui:HelpButton ToolTip="{Binding DataContext.T[Ui521],RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel><Slider Value="{Binding SoundBass}" Minimum="-24" Maximum="24"/><TextBlock Text="{Binding SoundBass,StringFormat={}{0:+0.0;-0.0;0} dB}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Saturation"/><ui:HelpButton ToolTip="{Binding DataContext.T[Ui502],RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel><Slider Value="{Binding SoundSaturation}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding SoundSaturation,StringFormat={}{0:0}%}"/><Button Content="{Binding T[Restore]}" Command="{Binding ResetSoundVolumeCommand}" FontSize="11"/><Button Content="Publish &amp; Share" Command="{Binding PublishSelectedSoundCommand}" Visibility="{Binding SelectedSound.Owned,Converter={StaticResource BoolVisibility}}"/><Expander Header="{Binding T[EditSound]}"><StackPanel><ComboBox ItemsSource="{Binding SoundModes}" SelectedItem="{Binding SoundMode}"/><ComboBox ItemsSource="{Binding Folders}" SelectedValuePath="Name" SelectedValue="{Binding SoundFolderName}" ItemTemplate="{StaticResource DeviceTemplate}"/><WrapPanel><Button Content="{Binding T[Rename]}" Command="{Binding RenameSoundCommand}"/><Button Content="{Binding T[Cover]}" ui:MediaDrop.ImageTarget="sound" Command="{Binding ChangeSoundCoverCommand}"/><Button Content="{Binding T[Delete]}" Command="{Binding DeleteSoundCommand}"/></WrapPanel></StackPanel></Expander></StackPanel></ScrollViewer></UserControl>
