<UserControl x:Class="MyVoice.App.Views.VoiceLabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services">
<UserControl.Resources><DataTemplate x:Key="AiModeTemplate"><TextBlock Text="{Binding Name}" ToolTip="{Binding Description}"/></DataTemplate></UserControl.Resources>
<StackPanel>
 <TextBlock Text="03 / VOICE ATELIER" Style="{StaticResource Label}"/>
 <DockPanel><Button DockPanel.Dock="Right" Content="{Binding T[CreateVoice]}" Command="{Binding ImportVoiceCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Voice Lab" Style="{StaticResource Heading}"/></DockPanel>
 <TextBlock Text="{Binding T[DatasetIntro]}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding AiState}" Foreground="{DynamicResource AccentBrush}" Margin="0,12"/>
 <Border Style="{StaticResource Card}"><StackPanel>
  <DockPanel><TextBlock Text="{Binding T[MyVoices]}" FontSize="18"/><ui:HelpButton ToolTip="{Binding T[SampleTips]}" HorizontalAlignment="Right"/></DockPanel>
  <ComboBox ItemsSource="{Binding AiVoices}" SelectedItem="{Binding SelectedAiVoice}" ItemTemplate="{StaticResource DeviceTemplate}"/>
  <TextBlock Text="{Binding DatasetSummary}" Style="{StaticResource MutedText}"/>
  <WrapPanel><Button Content="{Binding T[UseVoice]}" Command="{Binding UseAiVoiceCommand}" CommandParameter="{Binding SelectedAiVoice}"/><Button Content="{Binding T[Rename]}" Command="{Binding RenameAiVoiceCommand}"/><Button Content="{Binding T[Cover]}" Command="{Binding CoverAiVoiceCommand}"/><Button Content="Enregistrer une référence" Command="{Binding RecordReferenceCommand}"/><Button Content="Terminer l’enregistrement" Command="{Binding FinishReferenceCommand}" Visibility="{Binding ReferenceRecording,Converter={StaticResource BoolVisibility}}"/><Button Content="Annuler" Command="{Binding CancelReferenceCommand}" Visibility="{Binding ReferenceRecording,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
  <TextBlock Text="{Binding ReferenceRecordingStatus}" Foreground="{DynamicResource AccentBrush}"/><Expander Header="Échantillons de la voix"><StackPanel>
   <WrapPanel><Button Content="{Binding T[AddSamples]}" Command="{Binding AddSamplesCommand}"/><Button Content="{Binding T[PrepareVoice]}" Command="{Binding PrepareVoiceCommand}"/></WrapPanel>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding AiBusy,Converter={StaticResource BoolVisibility}}"/>
   <TextBlock Text="{Binding DatasetProgress}" Style="{StaticResource MutedText}"/>
   <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding DatasetSamples}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions><StackPanel ToolTip="{Binding Notes}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#BBB1A0"/></StackPanel><CheckBox Grid.Column="1" Content="Exclude" IsChecked="{Binding Excluded}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Text="{Binding T[ReferenceLimit]}" Style="{StaticResource MutedText}"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="{Binding T[RestoreVersion]}" Command="{Binding RestoreRevisionCommand}"/><ComboBox ItemsSource="{Binding VoiceRevisions}" SelectedItem="{Binding SelectedRevision}" DisplayMemberPath="Number"/></DockPanel>
  </StackPanel></Expander>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="{Binding T[Conversion]}" FontSize="18"/><TextBlock Text="Mode IA · microphone" Margin="0,12,0,0"/><ComboBox Style="{StaticResource EngineChoice}" ItemsSource="{Binding AiModelChoices}" SelectedValue="{Binding AiModel}" SelectedValuePath="Id" ItemTemplate="{StaticResource AiModeTemplate}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Expression et émotions · Expressive"/><ui:HelpButton ToolTip="Studio utilise le transfert de style de Seed-VC V2. Adaptatif choisit une référence selon l’énergie et les variations de hauteur de votre voix, en tenant compte des extraits. Il ne comprend pas le sens des mots. L’identité est consolidée à partir de plusieurs références (jusqu’à 64)."/></StackPanel><ComboBox IsEnabled="{Binding AiSupportsExpression}" ItemsSource="{Binding AiExpressionChoices}" SelectedValue="{Binding AiExpression}" SelectedValuePath="Id" ItemTemplate="{StaticResource DeviceTemplate}"/><TextBlock Text="Direct : latence minimale. Conversation : traitement continu avec contexte, recommandé pour Discord si le test de performance le permet. Expressive : transfert de style par phrases, jusqu’à 8 secondes, recommandé pour les fichiers. Sur CPU, le débit peut être insuffisant." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ConversationStatus}" Style="{StaticResource MutedText}"/><Button Content="Passer en Direct" Command="{Binding SwitchConversationToDirectCommand}" Visibility="{Binding ConversationNeedsDirect,Converter={StaticResource BoolVisibility}}"/><Button Content="Terminer ma phrase" Command="{Binding FinishAiPhraseCommand}" Visibility="{Binding AiLive,Converter={StaticResource BoolVisibility}}"/>
  <UniformGrid Columns="2" Margin="0,14,0,0"><StackPanel Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding T[Similarity]}" ToolTip="{Binding T[SimilarityTip]}"/><ui:HelpButton ToolTip="{Binding T[SimilarityTip]}"/></StackPanel><Slider Value="{Binding AiSimilarity}" Minimum="0" Maximum="100" ToolTip="{Binding T[SimilarityTip]}"/><TextBlock Text="{Binding AiSimilarity,StringFormat={}{0:0}%}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding T[Performance]}" ToolTip="{Binding T[PerformanceTip]}"/><ui:HelpButton ToolTip="{Binding T[PerformanceTip]}"/></StackPanel><ComboBox ItemsSource="{Binding AiProfileChoices}" SelectedValue="{Binding AiProfile}" SelectedValuePath="Id" ItemTemplate="{StaticResource DeviceTemplate}" ToolTip="{Binding T[PerformanceTip]}"/></StackPanel></UniformGrid>
  <StackPanel Orientation="Horizontal"><TextBlock Text="Calcul de la voix" ToolTip="Automatique choisit la carte NVIDIA si elle est disponible. CUDA utilise cette carte pour accélérer la voix. CPU utilise le processeur et fonctionne par phrases, avec davantage de délai. OpenCL n’est pas pris en charge par ce moteur."/><ui:HelpButton ToolTip="Automatique choisit la carte NVIDIA si elle est disponible. CUDA utilise cette carte pour accélérer la voix. CPU utilise le processeur et fonctionne par phrases, avec davantage de délai. OpenCL n’est pas pris en charge par ce moteur."/></StackPanel><ComboBox Style="{StaticResource EngineChoice}" ItemsSource="{Binding AiDeviceChoices}" SelectedValue="{Binding AiDevice}" SelectedValuePath="Id" ItemTemplate="{StaticResource DeviceTemplate}" ToolTip="Automatique choisit la carte NVIDIA si elle est disponible. CUDA utilise cette carte pour accélérer la voix. CPU utilise le processeur et fonctionne par phrases, avec davantage de délai. OpenCL n’est pas pris en charge par ce moteur."/>
  <TextBlock Text="Mode IA · conversion de fichiers" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding AiModelChoices}" SelectedValue="{Binding AiFileModel}" SelectedValuePath="Id" ItemTemplate="{StaticResource AiModeTemplate}"/><WrapPanel><Button Content="{Binding T[UseMicrophone]}" Command="{Binding UseAiVoiceCommand}" CommandParameter="{Binding SelectedAiVoice}"/><Button Content="{Binding T[ConvertFile]}" Command="{Binding ConvertFileCommand}"/><Button Content="{Binding T[PreviewResult]}" Command="{Binding PreviewResultCommand}"/></WrapPanel>
  <ProgressBar Value="{Binding ConversionProgress}" Margin="0,8"/><TextBlock Text="{Binding AiMetrics}" Style="{StaticResource MutedText}"/>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comparer les trois modes" FontSize="18"/><TextBlock Text="La même phrase et la même voix, pour juger le timbre et les jonctions à l’écoute. Enregistrement local de 15 secondes maximum." Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Enregistrer une phrase" Command="{Binding RecordComparisonCommand}"/><Button Content="Terminer" Command="{Binding FinishComparisonCommand}" Visibility="{Binding ComparisonRecording,Converter={StaticResource BoolVisibility}}"/><Button Content="Choisir un court fichier" Command="{Binding CompareFileCommand}"/></WrapPanel><TextBlock Text="{Binding ComparisonStatus}" Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding VoiceComparisons}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><Button Content="Écouter" DockPanel.Dock="Right" Command="{Binding DataContext.PlayComparisonCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Mode}" VerticalAlignment="Center"/><TextBlock Text="{Binding Seconds,StringFormat={} · calcul {0:0.00} s}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
 <Expander Header="Mesures développeur" Visibility="{Binding DeveloperMode,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ConversationMetrics}" Style="{StaticResource MutedText}"/></Expander>
 <Expander Header="{Binding T[Advanced]}"><StackPanel>
  <Button Content="{Binding T[Delete]}" Command="{Binding DeleteAiVoiceCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding AiState}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
  <WrapPanel><Button Content="{Binding T[StartAi]}" Command="{Binding StartAiCommand}"/><Button Content="{Binding T[StopAi]}" Command="{Binding StopAiCommand}"/></WrapPanel>
  <StackPanel Orientation="Horizontal"><CheckBox Content="{Binding T[PreserveDynamics]}" IsChecked="{Binding AiPreserveDynamics}" ToolTip="{Binding T[DynamicsTip]}"/><ui:HelpButton ToolTip="{Binding T[DynamicsTip]}"/></StackPanel><CheckBox Content="{Binding T[ReduceArtifacts]}" IsChecked="{Binding AiReduceArtifacts}"/>
  <StackPanel Orientation="Horizontal"><TextBlock Text="Ressources du processeur"/><ui:HelpButton ToolTip="Nombre de tâches simultanées utilisées par le processeur. Une valeur élevée peut ralentir vos autres applications. Le changement s’applique au prochain démarrage du moteur."/></StackPanel><Slider Value="{Binding AiCpuThreads}" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="{Binding AiAdvancedMetrics}" Style="{StaticResource MutedText}"/>
  <Button Content="Installer / réparer le moteur" Command="{Binding InstallAiRuntimeCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding T[AiInstallHint]}" Style="{StaticResource MutedText}"/>
  <DockPanel><Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowsePythonCommand}"/><TextBox Text="{Binding AiPython}"/></DockPanel><DockPanel><Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseAiRepositoryCommand}"/><TextBox Text="{Binding AiRepository}"/></DockPanel>
  <TextBox Text="{Binding AiLog,Mode=OneWay}" IsReadOnly="True" Height="150" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel></Expander>
</StackPanel></UserControl>
