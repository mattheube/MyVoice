<UserControl x:Class="MyVoice.App.Views.KeyboardSoundView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services">
<UserControl.Resources><ui:SameValue x:Key="SameValue"/></UserControl.Resources>
<Border Style="{StaticResource Card}" Margin="0,14"><StackPanel>
<DockPanel><CheckBox DockPanel.Dock="Right" Content="Activer" IsChecked="{Binding KeyboardEnabled}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Keyboard Sound" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedKeyboardName,StringFormat=Switch · {0}}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel>
<TextBlock Text="Une touche. Une texture. Des sons originaux synthétisés, uniquement dans le casque par défaut." Style="{StaticResource MutedText}" Margin="0,10"/>
<ItemsControl ItemsSource="{Binding KeyboardPacks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Button Width="148" Height="94" Margin="0,0,8,8" Command="{Binding DataContext.SelectKeyboardPackCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Choisir et écouter quatre touches">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SameValue}"><Binding Path="Id"/><Binding Path="DataContext.SelectedKeyboardPack" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
<StackPanel><DockPanel><Border Width="17" Height="17" Background="{Binding Color}" CornerRadius="4" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></Button>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel Margin="0,6"><Button Content="Écouter un aperçu" Command="{Binding PreviewKeyboardCommand}"/><CheckBox Content="Casque" IsChecked="{Binding KeyboardMonitor}"/><CheckBox Content="My Voice" IsChecked="{Binding KeyboardVirtual}" Margin="12,0"/><CheckBox Content="Stream" IsChecked="{Binding KeyboardStream}"/><CheckBox Content="Recording" IsChecked="{Binding KeyboardRecording}" Margin="12,0"/></WrapPanel>
<TextBlock Text="Volume du clavier" Style="{StaticResource Label}"/><DockPanel><TextBox DockPanel.Dock="Right" Width="65" Text="{Binding KeyboardVolume,StringFormat=F0,ValidatesOnExceptions=True}"/><Slider Minimum="0" Maximum="200" Value="{Binding KeyboardVolume}"/></DockPanel>
<Expander Header="Réglages avancés"><StackPanel>
<TextBlock Text="Hauteur (demi-tons)"/><Slider Minimum="-6" Maximum="6" Value="{Binding KeyboardPitch}" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="Intensité de frappe"/><Slider Minimum="0" Maximum="100" Value="{Binding KeyboardIntensity}"/><TextBlock Text="Volume de la barre espace"/><Slider Minimum="0" Maximum="200" Value="{Binding KeyboardSpaceVolume}"/>
<CheckBox Content="Jouer la répétition des touches maintenues" IsChecked="{Binding KeyboardRepeat}"/><CheckBox Content="Ignorer les touches de modification (Ctrl, Shift, Alt…)" IsChecked="{Binding KeyboardExcludeModifiers}"/><CheckBox Content="Ignorer les touches F1–F24" IsChecked="{Binding KeyboardExcludeFunctions}"/>
<TextBlock Text="Le raccourci « Toggle Keyboard Sound » se configure dans les réglages. Les touches multimédias sont ignorées." Style="{StaticResource MutedText}"/>
</StackPanel></Expander>
<TextBlock Text="{Binding KeyboardStatus}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/><TextBlock Text="Aucun texte, mot de passe ou historique de frappe n’est enregistré." Style="{StaticResource MutedText}" FontSize="11"/>
</StackPanel></Border></UserControl>
