<UserControl x:Class="MyVoice.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services"><StackPanel><TextBlock Text="04 / CONTROL ROOM" Style="{StaticResource Label}"/><TextBlock Text="{Binding T[Settings]}" Style="{StaticResource Heading}"/>

 <Border Style="{StaticResource Card}" Margin="0,16,0,14"><StackPanel><DockPanel><TextBlock Text="{Binding T[Routing]}" FontSize="18" FontWeight="SemiBold"/><Button Content="↻" Command="{Binding RefreshOutputsCommand}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding T[Input]}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding T[MonitoringDevice]}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding MonitoringDevice}" ItemTemplate="{StaticResource DeviceTemplate}"/><Slider Value="{Binding MonitoringVolumeSlider}" Maximum="200" AutomationProperties.Name="Headphone volume"/><TextBox Text="{Binding MonitoringVolume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="Volume du casque en %. La saisie numérique peut dépasser le curseur."/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding T[VirtualDevice]}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding VirtualDevice}" ItemTemplate="{StaticResource DeviceTemplate}"/><CheckBox Content="{Binding T[SendMicrophone]}" IsChecked="{Binding SendMicrophone}"/></StackPanel></Grid><TextBlock Text="{Binding T[VirtualHelp]}" Style="{StaticResource MutedText}"/><Button Content="{Binding T[GetCable]}" Command="{Binding OpenCableWebsiteCommand}" HorizontalAlignment="Left"/></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Audio Test" FontSize="18"/><TextBlock Text="Volume global des soundboards (%)" Margin="0,12,0,0"/><Slider Value="{Binding SoundboardVolumeSlider}" Maximum="400"/><TextBox Text="{Binding SoundboardVolume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="La saisie peut dépasser 400 %. Le limiteur de sortie reste actif."/><TextBlock Text="{Binding RouteStatus}" Style="{StaticResource MutedText}"/><UniformGrid Columns="4"><StackPanel Margin="0,8,12,8"><TextBlock Text="Physical mic"/><ProgressBar Value="{Binding Meter}" Margin="0,10"/></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Processed mic"/><ProgressBar Value="{Binding ProcessedMeter}" Margin="0,10"/></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Virtual mix"/><ProgressBar Value="{Binding OutputMeter}" Margin="0,10"/></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Headphones"/><ProgressBar Value="{Binding MonitorMeter}" Margin="0,10"/></StackPanel></UniformGrid><Button Content="Test Virtual Output · 1 s" Command="{Binding TestVirtualOutputCommand}" HorizontalAlignment="Left"/></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding T[Processing]}" FontSize="18" FontWeight="SemiBold"/><Button Content="{Binding T[Restore]}" Command="{Binding ResetProcessingCommand}" HorizontalAlignment="Right"/></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

 <StackPanel Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Noise Gate" ToolTip="{Binding T[GateTip]}" IsChecked="{Binding Gate}"/><ui:HelpButton ToolTip="{Binding T[GateTip]}"/></StackPanel><TextBlock Text="{Binding GateThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}"/><Slider ToolTip="{Binding T[GateTip]}" Value="{Binding GateThreshold}" Minimum="-70" Maximum="-10"/><Expander Header="{Binding T[Advanced]}"><StackPanel><TextBlock Text="Attack (ms)"/><Slider Value="{Binding GateAttack}" Minimum="1" Maximum="50"/><TextBlock Text="Release (ms)"/><Slider Value="{Binding GateRelease}" Minimum="20" Maximum="500"/></StackPanel></Expander></StackPanel>

 <StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Compressor" ToolTip="{Binding T[CompressorTip]}" IsChecked="{Binding Compressor}"/><ui:HelpButton ToolTip="{Binding T[CompressorTip]}"/></StackPanel><TextBlock Text="{Binding CompressorThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}"/><Slider Value="{Binding CompressorThreshold}" Minimum="-40" Maximum="-6"/><TextBlock Text="{Binding CompressorRatio,StringFormat=Ratio {0:0.0}:1}" Style="{StaticResource MutedText}"/><Slider ToolTip="{Binding T[CompressorTip]}" Value="{Binding CompressorRatio}" Minimum="1" Maximum="8"/></StackPanel>

 <StackPanel Grid.Column="2" Margin="7,0,0,0"><TextBlock Text="{Binding T[NoiseReduction]}" Margin="0,8,0,8"/><ComboBox SelectedIndex="{Binding NoiseSuppression}"><ComboBoxItem Content="Off"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox><CheckBox Content="Auto Gain" IsChecked="{Binding AutoGain}"/><TextBlock Text="{Binding T[LimiterNote]}" Style="{StaticResource MutedText}"/></StackPanel></Grid>

 <Border Height="1" Background="#3C3D3F" Margin="0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Button Content="Reset EQ" Command="{Binding ResetEqCommand}"/><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[BassTip]}" Text="BASS" Style="{StaticResource Label}"/><ui:HelpButton ToolTip="{Binding T[BassTip]}"/></StackPanel><Slider ToolTip="{Binding T[BassTip]}" Value="{Binding Bass}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding Bass,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[MidTip]}" Text="MID" Style="{StaticResource Label}"/><ui:HelpButton ToolTip="{Binding T[MidTip]}"/></StackPanel><Slider ToolTip="{Binding T[MidTip]}" Value="{Binding Mid}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding Mid,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="2" Margin="7,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[TrebleTip]}" Text="TREBLE" Style="{StaticResource Label}"/><ui:HelpButton ToolTip="{Binding T[TrebleTip]}"/></StackPanel><Slider ToolTip="{Binding T[TrebleTip]}" Value="{Binding Treble}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding Treble,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}"/></StackPanel></Grid>

 </StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[Hotkey]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding T[HotkeyHelp]}" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding HotkeyTargets}" SelectedItem="{Binding HotkeyTarget}"/><TextBlock Text="{Binding HotkeyLabel}" Foreground="#E0AD62" Margin="0,8"/><WrapPanel><Button x:Name="CaptureButton" Content="{Binding T[Bind]}" Click="BeginCapture" PreviewKeyDown="CaptureKey" LostKeyboardFocus="CancelCapture"/><Button Content="{Binding T[Clear]}" Command="{Binding ClearHotkeyCommand}"/></WrapPanel></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[General]}" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="{Binding T[Tray]}" IsChecked="{Binding CloseToTray}"/><CheckBox Content="{Binding T[Minimized]}" IsChecked="{Binding StartMinimized}"/><CheckBox Content="{Binding T[Startup]}" IsChecked="{Binding LaunchAtStartup}"/><CheckBox Content="{Binding T[Animations]}" IsChecked="{Binding Animations}"/><CheckBox Content="{Binding T[Notify]}" IsChecked="{Binding Notifications}"/><TextBlock Text="{Binding T[UiScale]}"/><Slider Minimum="0.85" Maximum="1.3" Value="{Binding UiScale}"/><Button Content="{Binding T[ResetAll]}" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding T[Language]}" Style="{StaticResource MutedText}"/><ComboBox SelectedIndex="{Binding LanguageIndex}" AutomationProperties.Name="Language"><ComboBoxItem Content="Français"/><ComboBoxItem Content="English"/></ComboBox></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[Update]}" FontSize="18"/><TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LatestVersion,StringFormat=Dernière version : {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LastChecked,StringFormat=Dernière vérification : {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding UpdateChannel,StringFormat=Canal : {0}}" Style="{StaticResource MutedText}"/><ProgressBar Value="{Binding UpdateProgress}"/><TextBlock Text="{Binding UpdateAvailability}" Style="{StaticResource MutedText}"/><CheckBox Content="{Binding T[CheckUpdates]}" IsChecked="{Binding CheckUpdatesAtStartup}"/><WrapPanel><Button Content="{Binding T[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}"/><Button Content="Afficher le téléchargement" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}"/></WrapPanel><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}"/><Expander Header="Avancé · mises à jour"><StackPanel><TextBlock Text="Adresse du manifeste HTTPS"/><TextBox Text="{Binding UpdateSource}"/><TextBlock Text="Laissez vide pour utiliser les releases officielles. Un manifeste local est accepté pour les tests développeur." Style="{StaticResource MutedText}"/></StackPanel></Expander><CheckBox Content="Mode développeur · mesures audio détaillées" IsChecked="{Binding DeveloperMode}"/></StackPanel></Border>

<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[About]}" FontSize="18"/><TextBlock Text="{Binding T[Privacy]}" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="{Binding T[OpenData]}" Command="{Binding OpenDataCommand}"/><Button Content="{Binding T[OpenLogs]}" Command="{Binding OpenLogsCommand}"/></WrapPanel></StackPanel></Border>

</StackPanel></UserControl>





