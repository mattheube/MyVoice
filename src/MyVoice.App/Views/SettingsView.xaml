<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MyVoice.App.Views.SettingsView">
 <StackPanel>
  <TextBlock Text="{Binding DataContext.T[Ui430],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}" />
  <TextBlock Text="{Binding DataContext.T[Ui592],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}" />
  <TabControl SelectedIndex="{Binding SettingsTab}">
   <TabItem Header="{Binding T[SettingsGeneralAudio]}">
    <StackPanel Margin="0,4,0,16">
     <views:MicrophoneEnhanceView/>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding T[EnginesTitle]}" FontSize="20" />
       <TextBlock Text="{Binding T[EnginesAutomaticHint]}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding EngineProvisionStatus}" TextWrapping="Wrap" Margin="0,8" />
       <Button Content="{Binding T[EnginesRepair]}" Command="{Binding RepairSupportedEnginesCommand}" HorizontalAlignment="Left" />
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding DataContext.T[Ui431],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" />
       <TextBlock Text="VB-Audio Virtual Cable" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding VirtualMicrophoneStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="17" />
       <StackPanel Visibility="{Binding VirtualMicrophoneMissing,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding DataContext.T[Ui432],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
        <Button Content="{Binding DataContext.T[Ui433],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenCableWebsiteCommand}" />
       </StackPanel>
       <WrapPanel>
        <Button Content="{Binding DataContext.T[Ui403],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RestoreCableRoutingCommand}" />
        <Button Content="{Binding DataContext.T[Ui434],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshCableCommand}" />
        <Button Content="{Binding DataContext.T[Ui435],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding TestVirtualOutputCommand}" />
        <Button Content="{Binding DataContext.T[Ui436],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding CopyCableNameCommand}" />
       </WrapPanel>
       <TextBlock Text="{Binding VirtualPlaybackName,StringFormat=MyVoice envoie vers : {0}}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding VirtualCaptureName,StringFormat=Micro à choisir dans Discord / OBS : {0}}" Style="{StaticResource MutedText}" />
       <Expander Header="{Binding DataContext.T[Ui534],RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel>
         <TextBlock Text="{Binding VirtualMicrophoneDiagnostics}" Style="{StaticResource MutedText}" />
         <TextBlock Text="{Binding DataContext.T[Ui601],RelativeSource={RelativeSource AncestorType=Window}}" />
         <ProgressBar Value="{Binding OutputMeter}" />
         <TextBlock Text="{Binding DataContext.T[Ui437],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
        </StackPanel>
       </Expander>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding T[General]}" FontSize="18" FontWeight="SemiBold" />
       <CheckBox Content="{Binding T[Tray]}" IsChecked="{Binding CloseToTray}" />
       <CheckBox Content="{Binding T[Minimized]}" IsChecked="{Binding StartMinimized}" />
       <CheckBox Content="{Binding T[Startup]}" IsChecked="{Binding LaunchAtStartup}" />
       <CheckBox Content="{Binding T[Notify]}" IsChecked="{Binding Notifications}" />
       <TextBlock Text="{Binding T[Language]}" Style="{StaticResource MutedText}" />
       <ComboBox SelectedIndex="{Binding LanguageIndex}" AutomationProperties.Name="Language">
        <ComboBoxItem Content="Français" />
        <ComboBoxItem Content="English" />
       </ComboBox>
      </StackPanel>
     </Border>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding T[SettingsAccount]}">
    <StackPanel Margin="0,4,0,16">
     <views:AccountSettingsView />
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding T[SettingsAppearance]}">
    <StackPanel Margin="0,4,0,16">
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding DataContext.T[Ui536],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" />
       <CheckBox Content="Liquid Glass" IsChecked="{Binding LiquidGlass}" />
       <StackPanel Margin="0,6,0,12" Visibility="{Binding LiquidGlass,Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding T[GlassExplanation]}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
        <CheckBox Content="{Binding T[GlassBlur]}" IsChecked="{Binding GlassBlur}" />
        <TextBlock Text="{Binding T[GlassIntensity]}" /><Slider Value="{Binding GlassIntensity}" Minimum="0" Maximum="100" />
        <TextBlock Text="{Binding T[GlassTransparency]}" /><Slider Value="{Binding GlassTransparency}" Minimum="0" Maximum="70" />
        <TextBlock Text="{Binding T[GlassDepth]}" /><Slider Value="{Binding GlassDepth}" Minimum="0" Maximum="100" />
       </StackPanel>
       <TextBlock Text="{Binding T[GlassHint]}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding DataContext.T[Theme],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}" />
       <ListBox ItemsSource="{Binding ThemePreviews}" SelectedValuePath="Id" SelectedValue="{Binding Theme}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
         <ItemsPanelTemplate>
          <WrapPanel />
         </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Width="142">
           <Border Height="76" CornerRadius="10" Background="{Binding Canvas}" BorderBrush="{Binding Line}" BorderThickness="1" Padding="10">
            <Grid>
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22" />
              <ColumnDefinition Width="*" />
             </Grid.ColumnDefinitions>
             <Border Background="{Binding Raised}" CornerRadius="4" Margin="0,0,6,0" />
             <StackPanel Grid.Column="1">
              <Border Height="8" Width="52" HorizontalAlignment="Left" CornerRadius="4" Background="{Binding Accent}" Margin="0,2,0,8" />
              <Border Height="25" CornerRadius="5" Background="{Binding Surface}" BorderBrush="{Binding Line}" BorderThickness="1" />
             </StackPanel>
            </Grid>
           </Border>
           <TextBlock Text="{Binding Name}" Margin="2,6,0,0" />
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="Accent · #RRGGBB" />
       <TextBox Text="{Binding Accent,UpdateSourceTrigger=LostFocus}" />
       <TextBlock Text="{Binding DataContext.T[Ui438],RelativeSource={RelativeSource AncestorType=Window}}" />
       <ComboBox ItemsSource="{Binding MotionModes}" SelectedItem="{Binding MotionMode}" />
       <TextBlock Text="{Binding DataContext.T[Ui439],RelativeSource={RelativeSource AncestorType=Window}}" />
       <ComboBox ItemsSource="{Binding DensityModes}" SelectedItem="{Binding Density}" />
       <TextBlock Text="{Binding DataContext.T[Ui440],RelativeSource={RelativeSource AncestorType=Window}}" />
       <ComboBox ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding BackgroundMode}" />
       <TextBlock Text="{Binding T[UiScale]}" />
       <Slider Minimum="0.85" Maximum="1.5" Value="{Binding UiScale}" />
      </StackPanel>
     </Border>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding T[SettingsShortcuts]}">
    <StackPanel Margin="0,4,0,16">
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding T[ShortcutSupported]}" Style="{StaticResource MutedText}" />
       <ListBox ItemsSource="{Binding ShortcutRows}" MaxHeight="460" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="85" />
           </Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0" />
           <ui:ShortcutCaptureButton Grid.Column="1" ActionId="{Binding Action}" Content="{Binding Shortcut}" />
           <Button Grid.Column="2" Content="{Binding DataContext.T[Clear],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.ClearShortcutCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Action}" />
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <Expander Header="{Binding T[ShortcutAdditional]}">
        <StackPanel>
         <ComboBox ItemsSource="{Binding HotkeyTargets}" SelectedItem="{Binding HotkeyTarget}" />
         <WrapPanel>
          <ui:ShortcutCaptureButton ActionId="{Binding EditingShortcutAction}" Content="{Binding T[Bind]}" />
          <Button Content="{Binding T[Clear]}" Command="{Binding ClearHotkeyCommand}" />
         </WrapPanel>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Border>
    </StackPanel>
   </TabItem>
   <TabItem Header="{Binding T[SettingsUpdates]}">
    <StackPanel Margin="0,4,0,16">
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding T[Update]}" FontSize="18" />
       <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding LatestVersion,StringFormat=Dernière version : {0}}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding LastChecked,StringFormat=Dernière vérification : {0}}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding DataContext.T[Ui441],RelativeSource={RelativeSource AncestorType=Window}}" />
       <ComboBox ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
       <TextBlock Text="{Binding DataContext.T[Ui442],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
       <ProgressBar Value="{Binding UpdateProgress}" IsIndeterminate="{Binding UpdateIndeterminate}" />
       <TextBlock Text="{Binding UpdateAvailability}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding T[AutomaticUpdateRequired]}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding DataContext.T[Ui444],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
       <WrapPanel>
        <Button Content="{Binding T[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" />
        <Button Content="{Binding DataContext.T[Ui445],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenReleaseNotesCommand}" />
        <Button Content="{Binding DataContext.T[Ui446],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" />
       </WrapPanel>
       <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" />
       <CheckBox Content="{Binding DataContext.T[Ui447],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding DeveloperMode}" />
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{Binding DataContext.T[Ui532],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" />
       <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}" />
       <TextBlock Text="{Binding DataContext.T[Ui448],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
       <WrapPanel>
        <Button Content="{Binding DataContext.T[Ui449],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenDataCommand}" />
        <Button Content="Diagnostics" Command="{Binding OpenLogsCommand}" />
        <Button Content="{Binding DataContext.T[Exit],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding QuitApplicationCommand}" />
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>
   </TabItem>
  </TabControl>
 </StackPanel>
</UserControl>
