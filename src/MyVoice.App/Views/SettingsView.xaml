<UserControl x:Class="MyVoice.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui430],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding DataContext.T[Ui592],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui431],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22"/><TextBlock Text="VB-Audio Virtual Cable" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VirtualMicrophoneStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="17"/><StackPanel Visibility="{Binding VirtualMicrophoneMissing,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding DataContext.T[Ui432],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/><Button Content="{Binding DataContext.T[Ui433],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenCableWebsiteCommand}"/></StackPanel><WrapPanel><Button Content="{Binding DataContext.T[Ui403],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RestoreCableRoutingCommand}"/><Button Content="{Binding DataContext.T[Ui434],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshCableCommand}"/><Button Content="{Binding DataContext.T[Ui435],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding TestVirtualOutputCommand}"/><Button Content="{Binding DataContext.T[Ui436],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding CopyCableNameCommand}"/></WrapPanel><TextBlock Text="{Binding VirtualPlaybackName,StringFormat=MyVoice envoie vers : {0}}" Style="{Sta