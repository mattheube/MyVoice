<UserControl x:Class="MyVoice.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="À VOTRE IMAGE" Style="{StaticResource Label}"/><TextBlock Text="Settings" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Virtual Microphone" FontSize="22"/><TextBlock Text="VB-Audio Virtual Cable" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding VirtualMicrophoneStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="17"/><StackPanel Visibility="{Binding VirtualMicrophoneMissing,Converter={StaticResource BoolVisibility}}"><TextBlock Text="MyVoice a besoin d’un périphérique audio virtuel pour envoyer votre voix et vos sons vers les autres applications." Style="{StaticResource MutedText}"/><Button Content="Installer le périphérique · site officiel" Command="{Binding OpenCableWebsiteCommand}"/></StackPanel><WrapPanel><Button Content="Diagnostiquer" Command="{Binding RefreshCableCommand}"/><Button Content="Tester la sortie" Command="{Binding TestVirtualOutputCommand}"/><Button Content="Copier le nom à choisir dans Discord" Command="{Binding CopyCableNameCommand}"/></WrapPanel><Expander Header="Advanced · Audio Diagnostics"><StackPanel><TextBlock Text="{Binding VirtualMicrophoneDiagnostics}" Style="{StaticResource MutedText}"/><TextBlock Text="Virtual Output Meter"/><ProgressBar Value="{Binding OutputMeter}"/><TextBlock Text="Le niveau indique le mix envoyé. Le microphone doit aussi être sélectionné dans l’application destinataire." Style="{StaticResource MutedText}"/></StackPanel></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[General]}" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="{Binding T[Tray]}" IsChecked="{Binding CloseToTray}" /><CheckBox Content="{Binding T[Minimized]}" IsChecked="{Binding StartMinimized}" /><CheckBox Content="{Binding T[Startup]}" IsChecked="{Binding LaunchAtStartup}" /><CheckBox Content="{Binding T[Notify]}" IsChecked="{Binding Notifications}" /><TextBlock Text="{Binding T[UiScale]}" /><Slider Minimum="0.85" Maximum="1.5" Value="{Binding UiScale}" /><TextBlock Text="{Binding T[Language]}" Style="{StaticResource MutedText}" /><ComboBox SelectedIndex="{Binding LanguageIndex}" AutomationProperties.Name="Language"><ComboBoxItem Content="Français" /><ComboBoxItem Content="English" /></ComboBox></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" FontSize="20"/><TextBlock Text="Thème" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/><TextBlock Text="Accent · #RRGGBB"/><TextBox Text="{Binding Accent,UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Animations · le réglage Windows est respecté"/><ComboBox ItemsSource="{Binding MotionModes}" SelectedItem="{Binding MotionMode}"/><TextBlock Text="Densité"/><ComboBox ItemsSource="{Binding DensityModes}" SelectedItem="{Binding Density}"/><TextBlock Text="Profondeur du fond"/><ComboBox ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding BackgroundMode}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[Hotkey]}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding T[HotkeyHelp]}" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{Binding HotkeyTargets}" SelectedItem="{Binding HotkeyTarget}" /><TextBlock Text="{Binding HotkeyLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,8" /><WrapPanel><Button x:Name="CaptureButton" Content="{Binding T[Bind]}" Click="BeginCapture" PreviewKeyDown="CaptureKey" LostKeyboardFocus="CancelCapture" /><Button Content="{Binding T[Clear]}" Command="{Binding ClearHotkeyCommand}" /></WrapPanel></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T[Update]}" FontSize="18" /><TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding LatestVersion,StringFormat=Dernière version : {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding LastChecked,StringFormat=Dernière vérification : {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="Canal de mise à jour"/><ComboBox ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}"/><TextBlock Text="Beta : versions de test, activées uniquement sur votre choix." Style="{StaticResource MutedText}"/><ProgressBar Value="{Binding UpdateProgress}" IsIndeterminate="{Binding UpdateIndeterminate}" /><TextBlock Text="{Binding UpdateAvailability}" Style="{StaticResource MutedText}" /><CheckBox Content="{Binding T[CheckUpdates]}" IsChecked="{Binding CheckUpdatesAtStartup}" /><WrapPanel><Button Content="{Binding T[CheckUpdates]}" Command="{Binding CheckUpdatesCommand}" /><Button Content="Notes de version" Command="{Binding OpenReleaseNotesCommand}"/><Button Content="Afficher le téléchargement" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" /></WrapPanel><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" /><CheckBox Content="Mode développeur · mesures audio détaillées" IsChecked="{Binding DeveloperMode}" /></StackPanel></Border>

<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="About" FontSize="20"/><TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MutedText}"/><TextBlock Text="Vos sons et vos voix restent locaux. Une publication demande toujours une action explicite." Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Mes fichiers" Command="{Binding OpenDataCommand}"/><Button Content="Diagnostics" Command="{Binding OpenLogsCommand}"/><Button Content="Quitter MyVoice" Command="{Binding QuitApplicationCommand}"/></WrapPanel></StackPanel></Border></StackPanel></UserControl>
