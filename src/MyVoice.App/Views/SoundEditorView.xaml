<UserControl x:Class="MyVoice.App.Views.SoundEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>
<TextBlock Text="{Binding T[RevisionLabel16]}" FontSize="24"/><TextBlock Text="{Binding EditorStatus}" Style="{StaticResource MutedText}"/>
<StackPanel IsEnabled="{Binding HasEditableSound}"><TextBlock Text="{Binding T[RevisionLabel10]}"/><TextBox Text="{Binding EditorName}" MaxLength="100"/><TextBlock Text="{Binding T[RevisionLabel4]}"/><TextBox Text="{Binding EditorDescription}" MaxLength="2000" Height="70" TextWrapping="Wrap"/><TextBlock Text="{Binding T[RevisionLabel2]}"/><ComboBox ItemsSource="{Binding SoundCategories}" SelectedItem="{Binding EditorCategory}"/><TextBlock Text="{Binding T[RevisionLabel13]}"/><TextBox Text="{Binding EditorTags}" MaxLength="400"/>
<UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding T[RevisionLabel5]}"/><TextBox Text="{Binding EditorStart,ValidatesOnExceptions=True}"/><TextBlock Text="{Binding T[RevisionLabel9]}"/><TextBox Text="{Binding EditorFadeIn,ValidatesOnExceptions=True}"/></StackPanel><StackPanel><TextBlock Text="{Binding T[RevisionLabel7]}"/><TextBox Text="{Binding EditorEnd,ValidatesOnExceptions=True}"/><TextBlock Text="{Binding T[RevisionLabel8]}"/><TextBox Text="{Binding EditorFadeOut,ValidatesOnExceptions=True}"/></StackPanel></UniformGrid>
<CheckBox Content="{Binding T[RevisionLabel11]}" IsChecked="{Binding EditorNormalize}"/><TextBlock Text="{Binding T[RevisionLabel14]}" FontSize="18" Margin="0,16,0,6"/><Slider Value="{Binding SoundVolumeSlider}" Maximum="400"/><TextBox Text="{Binding SoundVolume,ValidatesOnExceptions=True}"/><CheckBox Content="{Binding T[RevisionLabel15]}" IsChecked="{Binding SoundHear}"/><CheckBox Content="{Binding T[RevisionLabel6]}" IsChecked="{Binding SoundSend}"/><CheckBox Content="{Binding T[RevisionLabel1]}" IsChecked="{Binding SoundLoop}"/>
<WrapPanel><Button Content="{Binding T[RevisionLabel3]}" Command="{Binding ChangeSoundCoverCommand}"/><Button Content="{Binding T[RevisionLabel12]}" Command="{Binding PreviewSoundCommand}" CommandParameter="{Binding SelectedSound}"/><Button Content="{Binding T[RevisionLabel0]}" Command="{Binding ApplySoundEditCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></StackPanel></UserControl>
