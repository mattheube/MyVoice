<UserControl x:Class="MyVoice.App.Views.SoundboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" AllowDrop="True" Drop="FilesDropped" SizeChanged="LayoutChanged">
<UserControl.Resources><ui:LibraryViewport x:Key="LibraryViewport"/>
<Style x:Key="SoundTile" TargetType="Button"><Setter Property="Width" Value="164"/><Setter Property="Height" Value="194"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="{DynamicResource LineBrush}" CornerRadius="12" Margin="0,3,0,0"/><Border x:Name="Face" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,3"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><ContentPresenter/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<StackPanel><TextBlock Text="{Binding T[SoundDesk]}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="{Binding T[OpenBuilder]}" Command="{Binding CreateBoardInStudioCommand}"/><TextBlock Text="{Binding T[SoundTitle]}" Style="{StaticResource Heading}"/></DockPanel>
<TextBlock Text="{Binding T[SoundClickHelp]}" Style="{StaticResource MutedText}"/>
<Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding T[Search]}" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" Margin="0" ToolTip="Soundboard"/></Grid>
<WrapPanel><Button Content="{Binding T[AllSounds]}" Command="{Binding ShowLibraryCommand}"/><Button Content="Liked" Command="{Binding ShowLikedCommand}"/><ComboBox Width="170" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" DisplayMemberPath="Name" ToolTip="{Binding T[Collections]}"/><Button Content="{Binding T[NewCollection]}" Command="{Binding CreateCollectionCommand}"/><Button Content="{Binding T[Rename]}" Command="{Binding RenameCollectionCommand}" IsEnabled="{Binding HasCollection}"/><Button Content="{Binding T[RemoveCollection]}" Command="{Binding DeleteCollectionCommand}" IsEnabled="{Binding HasCollection}"/></WrapPanel>
<WrapPanel><Button Content="{Binding T[ImportPackage]}" Command="{Binding ImportPackageCommand}"/><Button Content="{Binding T[ImportSounds]}" Command="{Binding ImportSoundsCommand}"/><CheckBox Content="{Binding T[MultipleSounds]}" IsChecked="{Binding AllowMultipleSounds}" VerticalAlignment="Center" Margin="12,0"/></WrapPanel>
<ItemsControl ItemsSource="{Binding CollectionVoices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="164" Margin="0,8,12,12" Command="{Binding DataContext.ActivateCollectionVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><ui:CoverImage FilePath="{Binding Cover}" Circular="True" Width="64" Height="64"/><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Kind}" Style="{StaticResource MutedText}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="{Binding VisibleSoundCount}" Style="{StaticResource MutedText}"/>
<ListBox x:Name="SoundList" ItemsSource="{Binding SoundRows}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0" Padding="0">
<ListBox.Height><MultiBinding Converter="{StaticResource LibraryViewport}"><Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Window}"/><Binding Path="UiScale"/></MultiBinding></ListBox.Height>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Sounds}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Button Style="{StaticResource SoundTile}" Command="{Binding DataContext.PlaySoundCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" PreviewMouseLeftButtonDown="HoldStart" PreviewMouseLeftButtonUp="HoldStop" LostMouseCapture="HoldLost" ContextMenuOpening="OpenMenu" AutomationProperties.Name="{Binding Name}">
<Button.ContextMenu><ContextMenu/></Button.ContextMenu><Grid><Grid.RowDefinitions><RowDefinition Height="137"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="5"><Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"/><TextBlock Text="{Binding Initial}" FontSize="40" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding Cover}" Stretch="UniformToFill"/><Border Background="#88000000" CornerRadius="9"><Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocused,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style><Path Data="M 0,0 L 0,22 18,11 Z" Fill="White" Width="18" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Path Data="M 0,5 C 0,0 6,0 7,4 C 8,0 14,0 14,5 C 14,9 7,14 7,14 C 7,14 0,9 0,5" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsLiked,Converter={StaticResource BoolVisibility}}"/></Grid><StackPanel Grid.Row="1" Margin="11,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><DockPanel><TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="10" MaxWidth="105" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Duration}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right"/></DockPanel></StackPanel></Grid></Button>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="{Binding T[DropAudio]}" Style="{StaticResource MutedText}"/>
</StackPanel></UserControl>
