<UserControl x:Class="MyVoice.App.Views.SoundboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" AllowDrop="True" Drop="FilesDropped">
<StackPanel><TextBlock Text="02 / SAMPLE DESK" Style="{StaticResource Label}"/><DockPanel><TextBlock Text="{Binding T[SoundTitle]}" Style="{StaticResource Heading}"/><Button Content="{Binding T[AddSound]}" Command="{Binding ImportSoundsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding T[DropAudio]}" Style="{StaticResource MutedText}"/>
 <Grid Margin="0,18,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding T[Search]}" AutomationProperties.Name="Search sounds" Margin="0,0,14,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" ItemTemplate="{StaticResource DeviceTemplate}" Margin="0"/></Grid>
 <WrapPanel><Button Content="{Binding T[AllSounds]}" Command="{Binding AllSoundsCommand}"/><Button Content="{Binding T[NewFolder]}" Command="{Binding CreateFolderCommand}"/><Button Content="{Binding T[Rename]}" Command="{Binding RenameFolderCommand}"/><Button Content="{Binding T[Duplicate]}" Command="{Binding DuplicateFolderCommand}"/><Button Content="↑" Command="{Binding MoveFolderUpCommand}"/><Button Content="{Binding T[Cover]}" Command="{Binding ChangeFolderCoverCommand}"/><Button Content="{Binding T[Delete]}" Command="{Binding DeleteFolderCommand}"/></WrapPanel>
 <CheckBox Content="{Binding T[MultipleSounds]}" IsChecked="{Binding AllowMultipleSounds}" Margin="0,14,0,20"/>
 <ItemsControl ItemsSource="{Binding SoundView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="182" Height="246" Margin="0,0,16,16" Background="#292A2D" BorderBrush="#42413D" BorderThickness="1" CornerRadius="12" MouseLeftButtonUp="SelectCard" Cursor="Hand"><Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="64"/></Grid.RowDefinitions><Border Background="#36352F" CornerRadius="12,12,0,0" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initial}" FontSize="48" Foreground="#BCA781" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage Source="{Binding Cover}" Stretch="UniformToFill"/><Button Content="▶" Width="38" Height="38" Padding="0" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="Play sound" ToolTip="Play" PreviewMouseLeftButtonDown="HoldStart" PreviewMouseLeftButtonUp="HoldStop" LostMouseCapture="HoldLost" Command="{Binding DataContext.PlaySoundCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CircleButton}"/></Grid></Border><StackPanel Grid.Row="1" Margin="14,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding Folder}" Foreground="#A19D94" FontSize="10"/><TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" Foreground="#BBAA8A" FontSize="10"/></DockPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="{Binding T[SoundboardHint]}" Style="{StaticResource MutedText}" Margin="0,20,0,0"/>
</StackPanel></UserControl>



