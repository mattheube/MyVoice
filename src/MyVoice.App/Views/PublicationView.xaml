<UserControl x:Class="MyVoice.App.Views.PublicationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services">
<Border Style="{StaticResource Card}"><StackPanel>
 <TextBlock Text="PUBLISH &amp; SHARE" Style="{StaticResource Label}"/><TextBlock Text="{Binding T[RevisionLabel22]}" FontSize="24"/>
 <TextBlock Text="{Binding PublicationAvailability}" Style="{StaticResource MutedText}"/>
 <DockPanel Margin="0,14,0,8"><ui:CoverImage DockPanel.Dock="Left" Width="92" Height="92" FilePath="{Binding PublicationCover}" Margin="0,0,16,0"/><StackPanel><TextBlock Text="{Binding T[RevisionLabel10]}"/><TextBox Text="{Binding PublicationTitle,UpdateSourceTrigger=LostFocus}" MaxLength="100" IsEnabled="{Binding HasPublicationPackage}"/></StackPanel></DockPanel><TextBlock Text="{Binding PublicationKind}" Style="{StaticResource Label}"/>
 <WrapPanel><Button Content="Preview · casque" Command="{Binding PreviewPublicationCommand}"/><Button Content="Installer un package local" Command="{Binding ImportPackageCommand}"/><Button Content="{Binding T[RevisionLabel17]}" Command="{Binding ChoosePublicationPackageCommand}"/><Button Content="{Binding T[RevisionLabel18]}" Command="{Binding CreateBoardInStudioCommand}"/></WrapPanel>
 <TextBlock Text="{Binding T[RevisionLabel4]}" Margin="0,14,0,0"/><TextBox Text="{Binding PublishDescription,UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
 <TextBlock Text="{Binding T[RevisionLabel2]}"/><ComboBox ItemsSource="{Binding SoundCategories}" SelectedItem="{Binding PublishCategory}"/>
 <TextBlock Text="{Binding T[RevisionLabel13]}"/><TextBox Text="{Binding PublishTags,UpdateSourceTrigger=LostFocus}" MaxLength="250"/>
 <TextBlock Text="{Binding T[RevisionLabel24]}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding PublishVisibility}"><ComboBoxItem Content="Public" Tag="public"/><ComboBoxItem Content="Friends Only" Tag="friends"/><ComboBoxItem Content="Unlisted" Tag="unlisted"/><ComboBoxItem Content="Private" Tag="private"/></ComboBox>
 <TextBlock Text="{Binding T[RevisionLabel26]}" Style="{StaticResource MutedText}"/>
 <CheckBox Content="{Binding T[RevisionLabel20]}" IsChecked="{Binding PublishRights}"/>
 <WrapPanel><Button Content="Anciens brouillons" Command="{Binding RestorePublicationDraftCommand}"/><Button Content="{Binding T[RevisionLabel19]}" Command="{Binding SavePublicationDraftCommand}"/><Button Content="{Binding T[RevisionLabel23]}" Command="{Binding PublishPackageCommand}" IsEnabled="{Binding CanPublishDraft}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
 <TextBlock Text="{Binding PublicationStatus}" Style="{StaticResource MutedText}"/>
 <TextBlock Text="{Binding PublicationContents}" Style="{StaticResource MutedText}"/>
<TextBlock Text="Mes publications" FontSize="21" Margin="0,24,0,8"/><Button Content="Actualiser" Command="{Binding RefreshOwnPublicationsCommand}"/><ItemsControl ItemsSource="{Binding OwnPublications}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Visibility}" Margin="16,0" Style="{StaticResource MutedText}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border></UserControl>
