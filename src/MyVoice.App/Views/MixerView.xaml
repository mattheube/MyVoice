<UserControl x:Class="MyVoice.App.Views.MixerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services">
<UserControl.Resources><DataTemplate x:Key="MixerLabelTemplate"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate><Style x:Key="MixerFader" TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Width="32"><Border Width="3" Background="{DynamicResource LineBrush}"/><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="26" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources><StackPanel>
 <TextBlock Text="LE BON SON. AU BON ENDROIT." Style="{StaticResource Label}"/>
 <DockPanel><CheckBox DockPanel.Dock="Right" Content="Advanced" IsChecked="{Binding MixerAdvanced}" VerticalAlignment="Center"/><TextBlock Text="Mixer" Style="{StaticResource Heading}"/></DockPanel>
 <TextBlock Text="Réunissez vos sources, puis choisissez qui les entend." Style="{StaticResource MutedText}"/>
 <Border Style="{StaticResource Card}" Margin="0,20,0,16"><StackPanel>
  <DockPanel><Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshMixerDevicesCommand}"/><TextBlock Text="Audio Profile" FontSize="17" VerticalAlignment="Center"/></DockPanel>
  <WrapPanel><ComboBox Width="190" ItemsSource="{Binding AudioProfiles}" SelectedItem="{Binding SelectedAudioProfile}" ItemTemplate="{StaticResource DeviceTemplate}"/><Button Content="Charger" Command="{Binding LoadAudioProfileCommand}"/><TextBox Width="170" Text="{Binding MixerProfileName}" MaxLength="80" ToolTip="Nom du profil à enregistrer"/><Button Content="Sauvegarder" Command="{Binding SaveAudioProfileCommand}"/><Button Content="Dupliquer" Command="{Binding DuplicateAudioProfileCommand}"/><Button Content="Renommer" Command="{Binding RenameAudioProfileCommand}"/><Button Content="Supprimer" Command="{Binding DeleteAudioProfileCommand}"/></WrapPanel>
  <WrapPanel><Button Content="Discord / Gaming" Command="{Binding UseMixerTemplateCommand}" CommandParameter="Discord"/><Button Content="Streaming" Command="{Binding UseMixerTemplateCommand}" CommandParameter="Streaming"/><Button Content="Recording" Command="{Binding UseMixerTemplateCommand}" CommandParameter="Recording"/></WrapPanel>
  <WrapPanel Visibility="{Binding MixerAdvanced,Converter={StaticResource BoolVisibility}}"><Button Content="Importer un profil…" Command="{Binding ImportAudioProfileCommand}"/><Button Content="Exporter ce mix…" Command="{Binding ExportAudioProfileCommand}"/></WrapPanel><TextBlock Text="{Binding MixerStatus}" Style="{StaticResource MutedText}"/>
 </StackPanel></Border>
 <Expander Header="+ Ajouter une source" Margin="0,0,0,18"><StackPanel>
  <TextBlock Text="Une source est ajoutée à l’arrêt. Son bouton Capture permet ensuite de l’écouter dans le mix." Style="{StaticResource MutedText}"/>
  <ComboBox ItemsSource="{Binding MixerSourceTypes}" SelectedItem="{Binding MixerSourceType}"/>
  <StackPanel Visibility="{Binding IsDeviceSource,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Entrée physique ou virtuelle" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MixerInputs}" SelectedItem="{Binding MixerInput}" ItemTemplate="{StaticResource DeviceTemplate}"/></StackPanel>
  <StackPanel Visibility="{Binding IsApplicationSource,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Nouvelles applications"/><ComboBox ItemsSource="{Binding NewApplicationPolicies}" SelectedItem="{Binding NewApplicationPolicy}"/><TextBlock Text="Monitor écoute la copie capturée. Si Windows diffuse déjà cette application dans votre casque, désactivez Monitor pour éviter un son doublé." Style="{StaticResource MutedText}"/><TextBlock Text="Application avec une session audio" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MixerApplications}" SelectedItem="{Binding MixerApplication}" ItemTemplate="{StaticResource MixerLabelTemplate}"/></StackPanel>
  <StackPanel Visibility="{Binding IsSystemSource,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Sortie à capturer pour System Audio" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MixerSystemInputs}" SelectedItem="{Binding MixerSystemInput}" ItemTemplate="{StaticResource DeviceTemplate}"/></StackPanel>
  <Button Content="Ajouter cette source" Command="{Binding AddMixerSourceCommand}" HorizontalAlignment="Left"/>
 </StackPanel></Expander>
 <TextBlock Text="SOURCES" Style="{StaticResource Label}"/>
 <ScrollViewer ui:HorizontalScroll.Enabled="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,18">
 <ItemsControl ItemsSource="{Binding MixerChannels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="226" Margin="0,0,12,4" Padding="17"><StackPanel>
  <TextBlock Text="{Binding Kind}" Style="{StaticResource Label}"/>
  <Button Content="{Binding Name}" Command="{Binding DataContext.SelectMixerChannelCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" FontSize="16" HorizontalContentAlignment="Left" Margin="0,8,0,8"/>
  <Grid Height="140"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
   <ui:MixerLevelMeter Level="{Binding Level}" Clipping="{Binding Clipping}" Width="12" Height="130"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Volume,StringFormat={}{0:0} %}" FontSize="28" Foreground="{DynamicResource AccentBrush}"/><TextBox Text="{Binding Volume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="Niveau envoyé au mix, en %. Saisie numérique au-delà du curseur possible."/></StackPanel>
   <Slider Grid.Column="2" Style="{StaticResource MixerFader}" Orientation="Vertical" Minimum="0" Maximum="200" Value="{Binding VolumeSlider}" Height="126" AutomationProperties.Name="Volume du canal"/>
  </Grid>
  <TextBlock Text="{Binding Meter}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,10"/>
  <WrapPanel><CheckBox Content="Mute" IsChecked="{Binding Mute}"/><CheckBox Content="Solo" IsChecked="{Binding Solo}" Margin="12,0,0,0" ToolTip="Isole ce canal dans le casque. Le micro virtuel et les enregistrements continuent normalement."/><CheckBox Content="Mono" IsChecked="{Binding Mono}" Margin="12,0,0,0"/></WrapPanel>
  <CheckBox Content="Jamais vers le micro virtuel" IsChecked="{Binding NeverSendVirtual}" Visibility="{Binding IsApplication,Converter={StaticResource BoolVisibility}}" ToolTip="Règle sauvegardée avec le canal et les profils, même après fermeture de cette application. Prioritaire sur la matrice."/>
  <CheckBox Content="Capture" IsChecked="{Binding CaptureEnabled}" Visibility="{Binding CanRemove,Converter={StaticResource BoolVisibility}}" ToolTip="Démarrer ou arrêter la capture de cette source."/>
  <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0"/>
 </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <DockPanel><Button DockPanel.Dock="Right" Content="+ Sortie" Command="{Binding AddMixerOutputCommand}"/><TextBlock Text="SORTIES ET BUS" Style="{StaticResource Label}" VerticalAlignment="Center"/></DockPanel>
 <ScrollViewer ui:HorizontalScroll.Enabled="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding MixerOutputs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
 <Border Style="{StaticResource Card}" Width="226" Margin="0,8,12,8" Padding="17"><StackPanel>
  <Button Content="{Binding Name}" Command="{Binding DataContext.SelectMixerOutputCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"/>
  <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Id" ItemTemplate="{StaticResource DeviceTemplate}" SelectedValue="{Binding Device}" ToolTip="Bus interne, périphérique fixe ou périphérique Windows par défaut."><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="virtual"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="{Binding Value.DeviceName,TargetNullValue=VB-CABLE non détecté}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="virtual"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <ProgressBar Value="{Binding Level,Mode=OneWay}" Margin="0,12"/><TextBlock Text="{Binding Meter}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
  <Slider Value="{Binding VolumeSlider}" Maximum="150"/><TextBox Text="{Binding Volume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="Volume de cette sortie (%) · limiteur toujours actif"/>
  <CheckBox Content="Mute output" IsChecked="{Binding Mute}"/><TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" FontSize="10"/>
 </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <Border Style="{StaticResource Card}" Margin="0,18"><StackPanel>
  <DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Une ligne est une source ; une colonne est une sortie. Un interrupteur activé envoie ce son vers cette destination. Stream et Recording peuvent rester internes."/><TextBlock Text="Routing Matrix" FontSize="22"/></DockPanel>
  <ScrollViewer ui:HorizontalScroll.Enabled="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"><StackPanel>
   <ItemsControl Margin="174,0,0,0" ItemsSource="{Binding MixerOutputs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Width="118" Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ItemsControl ItemsSource="{Binding MixerRows}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,12"><TextBlock Text="{Binding Name}" Width="174" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ItemsControl ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Width="118"><CheckBox IsEnabled="{Binding CanEdit}" IsChecked="{Binding Enabled}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" HorizontalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
  <TextBlock Text="{Binding MixerWarnings}" Foreground="#FFCD8A" TextWrapping="Wrap" Margin="0,12"/>
  <WrapPanel><Button Content="Corriger les boucles détectées" Command="{Binding FixMixerLoopsCommand}"/><Button Content="Routage recommandé" Command="{Binding ResetMixerRoutingCommand}"/></WrapPanel>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Visibility="{Binding MixerAdvanced,Converter={StaticResource BoolVisibility}}"><StackPanel>
  <TextBlock Text="Canal sélectionné · EQ / FX" FontSize="22"/>
  <StackPanel Visibility="{Binding SelectedMixerChannel.CanRemove,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Périphérique / application de cette source"/><ComboBox Visibility="{Binding IsDeviceSource,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding MixerInputs}" SelectedItem="{Binding MixerInput}" ItemTemplate="{StaticResource DeviceTemplate}"/><ComboBox Visibility="{Binding IsSystemSource,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding MixerSystemInputs}" SelectedItem="{Binding MixerSystemInput}" ItemTemplate="{StaticResource DeviceTemplate}"/><ComboBox Visibility="{Binding IsApplicationSource,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding MixerApplications}" SelectedItem="{Binding MixerApplication}" ItemTemplate="{StaticResource MixerLabelTemplate}"/><Button Content="Relier cette source · capture arrêtée" Command="{Binding RelinkMixerSourceCommand}"/></StackPanel><StackPanel DataContext="{Binding SelectedMixerChannel}"><TextBox Text="{Binding Name}" MaxLength="80"/>
   <TextBlock Text="{Binding Chain}" Style="{StaticResource MutedText}"/>
   <TextBlock Text="Balance · gauche / centre / droite" Margin="0,15,0,0"/><Slider Minimum="-100" Maximum="100" Value="{Binding Pan}"/><TextBlock Text="{Binding Pan,StringFormat={}{0:0} %}"/>
   <StackPanel Visibility="{Binding HasInputGain,Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="Gain d’entrée (dB)"/><Slider Value="{Binding Gain}" Minimum="-30" Maximum="30"/><TextBlock Text="{Binding Gain,StringFormat={}{0:0.0} dB}"/>
    <UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Bass"/><Slider Value="{Binding Bass}" Minimum="-18" Maximum="18"/><TextBlock Text="{Binding Bass,StringFormat={}{0:0.0} dB}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Mid"/><Slider Value="{Binding Mid}" Minimum="-18" Maximum="18"/><TextBlock Text="{Binding Mid,StringFormat={}{0:0.0} dB}"/></StackPanel><StackPanel><TextBlock Text="Treble"/><Slider Value="{Binding Treble}" Minimum="-18" Maximum="18"/><TextBlock Text="{Binding Treble,StringFormat={}{0:0.0} dB}"/></StackPanel></UniformGrid>
    <TextBlock Text="High Pass · 0 = désactivé"/><Slider Value="{Binding HighPass}" Maximum="1000"/><TextBlock Text="{Binding HighPass,StringFormat={}{0:0} Hz}"/>
    <UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Delay"/><Slider Value="{Binding Delay}" Maximum="100"/></StackPanel><StackPanel><TextBlock Text="Reverb"/><Slider Value="{Binding Reverb}" Maximum="100"/></StackPanel></UniformGrid>
    <StackPanel Visibility="{Binding IsMicrophoneInput,Converter={StaticResource BoolVisibility}}"><CheckBox Content="Noise Gate" IsChecked="{Binding Gate}"/><UniformGrid Columns="4"><StackPanel Margin="0,0,12,0"><TextBlock Text="Seuil · dB"/><TextBox Text="{Binding GateThreshold,ValidatesOnExceptions=True}" ToolTip="-90 à 0"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Attack · ms"/><TextBox Text="{Binding GateAttackMs,ValidatesOnExceptions=True}" ToolTip="1 à 200"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Hold · ms"/><TextBox Text="{Binding GateHoldMs,ValidatesOnExceptions=True}" ToolTip="0 à 2000"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Release · ms"/><TextBox Text="{Binding GateReleaseMs,ValidatesOnExceptions=True}" ToolTip="1 à 2000"/></StackPanel></UniformGrid><TextBlock Text="Noise Reduction · Off / Light / Balanced / Strong"/><Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NoiseReduction}" ToolTip="Light conserve davantage de détails ; Strong atténue plus le bruit mais peut colorer la voix."/></StackPanel>
    <CheckBox Content="Compressor" IsChecked="{Binding Compressor}"/><TextBlock Text="Seuil"/><Slider Value="{Binding Threshold}" Minimum="-60" Maximum="0"/><TextBlock Text="{Binding Threshold,StringFormat={}{0:0} dB}"/><TextBlock Text="Ratio"/><Slider Value="{Binding Ratio}" Minimum="1" Maximum="20"/><UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Attack · ms"/><TextBox Text="{Binding CompressorAttackMs,ValidatesOnExceptions=True}" ToolTip="1 à 200"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Release · ms"/><TextBox Text="{Binding CompressorReleaseMs,ValidatesOnExceptions=True}" ToolTip="1 à 2000"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Makeup · dB"/><TextBox Text="{Binding MakeupDb,ValidatesOnExceptions=True}" ToolTip="-12 à 18"/></StackPanel></UniformGrid>
   </StackPanel>
  </StackPanel>
  <WrapPanel><Button Content="Reset Channel" Command="{Binding ResetMixerChannelCommand}"/><Button Content="Qualité du micro → Mic Setup" Command="{Binding NavigateCommand}" CommandParameter="6"/><Button Content="Retirer la source sélectionnée" Command="{Binding RemoveMixerSourceCommand}" CommandParameter="{Binding SelectedMixerChannel}"/></WrapPanel>
 </StackPanel></Border>
 <Border Style="{StaticResource Card}" Visibility="{Binding MixerAdvanced,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Advanced Audio · sortie sélectionnée" FontSize="20"/><TextBlock Text="WASAPI est recommandé. ASIO apparaît uniquement lorsqu’un driver est installé. WDM/KS n’est pas fourni par ce moteur." Style="{StaticResource MutedText}"/><TextBox Text="{Binding SelectedMixerOutput.Name}" MaxLength="80"/><Button Content="Retirer la sortie sélectionnée" Command="{Binding RemoveMixerOutputCommand}" IsEnabled="{Binding SelectedMixerOutput.CanRemove}"/><ComboBox ItemsSource="{Binding MixerBackends}" SelectedItem="{Binding SelectedMixerOutput.Backend}"/><TextBlock Text="Tampon demandé (ms) · Recommended : 30"/><ComboBox ItemsSource="{Binding MixerBuffers}" SelectedItem="{Binding SelectedMixerOutput.BufferMs}"/><TextBlock Text="Égaliseur de sortie · avant le limiteur" FontSize="18" Margin="0,16,0,8"/><ItemsControl ItemsSource="{Binding SelectedMixerOutput.EqualizerBands}"><ItemsControl.ItemTemplate><DataTemplate><UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Fréquence · Hz"/><TextBox Text="{Binding Frequency,ValidatesOnExceptions=True}"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Gain · dB"/><TextBox Text="{Binding Gain,ValidatesOnExceptions=True}"/></StackPanel><StackPanel><TextBlock Text="Q · largeur de bande"/><TextBox Text="{Binding Q,ValidatesOnExceptions=True}"/></StackPanel></UniformGrid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="0 dB = neutre. Fréquences 20–20 000 Hz ; Q faible = bande large. Le limiteur reste actif après l’EQ." Style="{StaticResource MutedText}"/><TextBlock Text="ASIO utilise la taille réelle choisie dans son driver." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding MixerDiagnostics}" Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></Border>
 <Border Style="{StaticResource Card}" Visibility="{Binding MixerAdvanced,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="MIDI &amp; Shortcuts" FontSize="22"/><TextBlock Text="Les commandes MIDI ciblent le canal, la sortie ou le profil sélectionnés. Les raccourcis clavier se configurent dans Settings." Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding MidiDevices}" SelectedItem="{Binding SelectedMidiDevice}"/><WrapPanel><Button Content="Actualiser MIDI" Command="{Binding RefreshMidiDevicesCommand}"/><Button Content="Connecter" Command="{Binding ConnectMidiCommand}"/><Button Content="Déconnecter" Command="{Binding DisconnectMidiCommand}"/></WrapPanel><ComboBox ItemsSource="{Binding MidiActions}" SelectedItem="{Binding MidiAction}"/><WrapPanel><Button Content="MIDI Learn" Command="{Binding LearnMidiCommand}"/><Button Content="Annuler" Command="{Binding CancelMidiLearnCommand}"/><Button Content="Raccourcis clavier →" Command="{Binding NavigateCommand}" CommandParameter="3"/></WrapPanel><TextBlock Text="{Binding MidiStatus}" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding MidiAssignments}" SelectedItem="{Binding SelectedMidiAssignment}" ItemTemplate="{StaticResource MixerLabelTemplate}"/><Button Content="Retirer cette commande" Command="{Binding RemoveMidiAssignmentCommand}"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recording" FontSize="22"/><TextBlock Text="Recording Mix permet de choisir plusieurs canaux dans la matrice. L’enregistrement commence après le choix du fichier WAV." Style="{StaticResource MutedText}"/><ComboBox Tag="recording-target" ItemsSource="{Binding RecordingSources}" ItemTemplate="{StaticResource DeviceTemplate}" SelectedItem="{Binding SelectedRecordingTarget}"/><WrapPanel><Button Content="● Enregistrer…" Command="{Binding RequestMixerRecordingCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="■ Arrêter" Command="{Binding StopMixerRecordingCommand}" IsEnabled="{Binding IsRecording}"/></WrapPanel><TextBlock Text="{Binding RecordingStatus}" Style="{StaticResource MutedText}"/></StackPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dans Discord, OBS, Teams ou Zoom" FontSize="18"/><TextBlock Text="Choisissez CABLE Output comme microphone pour recevoir le bus Virtual Mic. Pour isoler Stream Mix, affectez-lui une seconde sortie virtuelle disponible. Ne choisissez pas deux bus sur le même périphérique." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CableStatus}" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Copier le nom du microphone virtuel" Command="{Binding CopyCableNameCommand}"/><Button Content="Rétablir VB-CABLE" Command="{Binding RestoreCableRoutingCommand}"/><Button Content="Site officiel VB-Audio" Command="{Binding OpenCableWebsiteCommand}"/><Button Content="Test Virtual Output · 1 s" Command="{Binding TestVirtualOutputCommand}"/></WrapPanel></StackPanel></Border>
</StackPanel></UserControl>
