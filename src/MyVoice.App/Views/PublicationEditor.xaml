<Window x:Class="MyVoice.App.Views.PublicationEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" Title="MyVoice" Width="670" Height="790" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource MutedBrush}" />
   <WrapPanel HorizontalAlignment="Right"><Button Content="{Binding T[Cancel]}" Click="Cancel"/><Button x:Name="SaveButton" Content="{Binding T[PublicationEditSave]}" Click="Save" Style="{StaticResource PrimaryButton}" /></WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields">
   <TextBlock Text="{Binding T[PublicationEditTitle]}" Style="{StaticResource Heading}" />
   <TextBlock Text="{Binding T[PublicationEditName]}"/><TextBox x:Name="CreationTitle" MaxLength="100"/>
   <TextBlock Text="{Binding T[PublicationEditDescription]}"/><TextBox x:Name="Description" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="90"/>
   <TextBlock Text="{Binding T[PublicationEditTags]}"/><TextBox x:Name="Tags" MaxLength="247"/>
   <TextBlock Text="{Binding T[PublicationEditVisibility]}"/><ComboBox x:Name="VisibilityChoice" ItemsSource="{Binding VisibilityChoices}" SelectedValuePath="Value" DisplayMemberPath="Label"/>
   <TextBlock Text="{Binding T[PublicationEditCategory]}"/><ComboBox x:Name="Category" ItemsSource="{Binding SoundCategories}"/>
   <WrapPanel Margin="0,10"><ui:CoverImage x:Name="CoverPreview" Width="110" Height="110" Stretch="UniformToFill"/><StackPanel Margin="14,0"><Button Content="{Binding T[PublicationEditCover]}" Click="ChooseCover"/><Button Content="{Binding T[PublicationEditPreview]}" Click="ChoosePreview"/></StackPanel></WrapPanel>
   <TextBlock x:Name="AudioNotice" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10"/>
   <Button x:Name="ReplaceAudioButton" Content="{Binding T[PublicationReplaceAudio]}" Click="ChoosePackage" HorizontalAlignment="Left"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
