<UserControl x:Class="MyVoice.App.Views.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MyVoice.App.Views" xmlns:ui="clr-namespace:MyVoice.App.Services"><StackPanel>
<TextBlock Text="{Binding DataContext.T[Ui406],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding DataContext.T[RevisionLabel45],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding AccountStatus}" Style="{StaticResource MutedText}" Margin="0,12"/>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SignedIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui407],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21"/><WrapPanel Margin="0,16"><Button Content="{Binding DataContext.T[RevisionLabel34],RelativeSource={RelativeSource AncestorType=Window}}" Click="ShowRegister" Style="{StaticResource PrimaryButton}"/><Button Content="{Binding DataContext.T[RevisionLabel48],RelativeSource={RelativeSource AncestorType=Window}}" Click="ShowLogin"/></WrapPanel>
<StackPanel x:Name="AccountForm" Visibility="Collapsed" IsEnabled="{Binding CommunityConfigured}"><TextBlock Text="{Binding DataContext.T[Ui408],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox x:Name="Email" AutomationProperties.Name="Email"/><StackPanel x:Name="RegistrationFields"><TextBlock Text="{Binding DataContext.T[Ui600],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox x:Name="Username" AutomationProperties.Name="Username"/><TextBlock Text="{Binding DataContext.T[RevisionLabel41],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox x:Name="DisplayName"/></StackPanel><TextBlock Text="{Binding DataContext.T[Ui409],RelativeSource={RelativeSource AncestorType=Window}}"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8"/><ProgressBar x:Name="Strength" Maximum="3"/><TextBlock x:Name="StrengthText" Style="{StaticResource MutedText}"/><StackPanel x:Name="ConfirmationFields"><TextBlock Text="{Binding DataContext.T[Ui548],RelativeSource={RelativeSource AncestorType=Window}}"/><PasswordBox x:Name="Confirmation" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8"/><TextBlock x:Name="MatchText" Style="{StaticResource MutedText}"/></StackPanel><WrapPanel><Button x:Name="RegisterButton" Content="{Binding DataContext.T[Ui410],RelativeSource={RelativeSource AncestorType=Window}}" Click="Register"/><Button x:Name="LoginButton" Content="{Binding DataContext.T[Ui411],RelativeSource={RelativeSource AncestorType=Window}}" Click="Login"/><Button Content="{Binding DataContext.T[RevisionLabel39],RelativeSource={RelativeSource AncestorType=Window}}" Click="Recover"/></WrapPanel></StackPanel></StackPanel></Border></StackPanel>
<TabControl Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}" Margin="0,16">
<TabItem Header="{Binding DataContext.T[Ui412],RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel Margin="20"><DockPanel><Grid ui:MediaDrop.ImageTarget="avatar" DockPanel.Dock="Left" Width="104" Height="104" Margin="0,0,24,0"><Ellipse Fill="{DynamicResource AccentSoftBrush}"/><ui:CoverImage FilePath="{Binding ProfileAvatar}" Circular="True" Width="104" Height="104"/></Grid><StackPanel><TextBlock Text="{Binding ProfileName}" FontSize="30"/><TextBlock Text="{Binding ProfileUsername,StringFormat=@{0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DataContext.T[Ui608],RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ProfileVerified,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ProfileBio}" Margin="0,10"/><WrapPanel><Button Tag="followers" Click="ShowActivity" MinWidth="120" Padding="14,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileFollowerCount}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding T[ProfileFollowers]}" Style="{StaticResource MutedText}"/></StackPanel></Button><Button Tag="following" Click="ShowActivity" MinWidth="120" Padding="14,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileFollowingCount}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding T[ProfileFollowing]}" Style="{StaticResource MutedText}"/></StackPanel></Button><Button Tag="likes" Click="ShowActivity" MinWidth="120" Padding="14,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileLikeCount}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding T[ProfileLikes]}" Style="{StaticResource MutedText}"/></StackPanel></Button></WrapPanel></StackPanel></DockPanel>
<Button Content="{Binding DataContext.T[Ui413],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshPublicProfileCommand}" HorizontalAlignment="Left"/>
<Expander Header="{Binding DataContext.T[Ui414],RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,18"><StackPanel><Button Content="{Binding DataContext.T[Ui415],RelativeSource={RelativeSource AncestorType=Window}}" ui:MediaDrop.ImageTarget="avatar" Command="{Binding ChangeAvatarCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding DataContext.T[RevisionLabel41],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Text="{Binding ProfileName}" MaxLength="60"/><TextBlock Text="{Binding DataContext.T[Ui600],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Text="{Binding ProfileUsername}" MaxLength="24"/><TextBlock Text="{Binding DataContext.T[RevisionLabel30],RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Text="{Binding ProfileBio}" MaxLength="300" TextWrapping="Wrap" Height="80"/><Button Content="{Binding DataContext.T[Ui416],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveOnlineProfileCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
<TextBlock Text="Publications" FontSize="22" Margin="0,12"/><ComboBox Width="210" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ProfilePublicationKind}"><ComboBoxItem Content="Publications" Tag="all"/><ComboBoxItem Content="{Binding DataContext.T[Ui594],RelativeSource={RelativeSource AncestorType=Window}}" Tag="soundboard"/><ComboBoxItem Content="AI Voices" Tag="ai-voice"/><ComboBoxItem Content="{Binding DataContext.T[Ui605],RelativeSource={RelativeSource AncestorType=Window}}" Tag="voice-preset"/></ComboBox>
<ItemsControl ItemsSource="{Binding ProfilePublications}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><views:CreationCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Publish &amp; Share" Command="{Binding OpenPublicationCommand}"/>
</StackPanel></TabItem>
<TabItem Header="{Binding DataContext.T[Ui417],RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel Margin="20"><TextBlock Text="{Binding DataContext.T[Ui408],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding ProfileEmail}" FontSize="18" Margin="0,8"/><CheckBox Content="{Binding DataContext.T[Ui418],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding ProfilePrivate}"/><Button Content="{Binding DataContext.T[Ui419],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveProfilePrivacyCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding DataContext.T[Ui420],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/>
<Expander Header="{Binding DataContext.T[Ui421],RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20"><StackPanel><PasswordBox x:Name="NewPassword" Padding="10"/><PasswordBox x:Name="NewConfirmation" Padding="10" Margin="0,8"/><Button Content="{Binding DataContext.T[Ui422],RelativeSource={RelativeSource AncestorType=Window}}" Click="ChangePassword"/></StackPanel></Expander><Button Content="{Binding DataContext.T[RevisionLabel39],RelativeSource={RelativeSource AncestorType=Window}}" Click="RecoverSignedIn" HorizontalAlignment="Left"/><Button Content="{Binding DataContext.T[Ui423],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="{Binding DataContext.T[Ui424],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" Margin="0,20,0,8"/><Button Content="{Binding DataContext.T[RevisionLabel28],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshSocialCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding SocialContacts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Username,StringFormat=@{0}}"/><WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="request"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="{Binding DataContext.T[RevisionLabel27],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.AcceptFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="{Binding DataContext.T[RevisionLabel47],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DeclineFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="{Binding DataContext.T[Ui425],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DeleteAccountCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="0,24"/>
</StackPanel></TabItem></TabControl></StackPanel></UserControl>
