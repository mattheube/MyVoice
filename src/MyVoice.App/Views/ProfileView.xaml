<UserControl x:Class="MyVoice.App.Views.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services"><StackPanel>
<TextBlock Text="VOTRE COMPTE" Style="{StaticResource Label}"/><TextBlock Text="Profile" Style="{StaticResource Heading}"/><TextBlock Text="{Binding AccountStatus}" Style="{StaticResource MutedText}" Margin="0,12"/>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SignedIn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Créez un compte MyVoice pour créer votre profil, publier vos créations et suivre d'autres utilisateurs." FontSize="21"/><WrapPanel Margin="0,16"><Button Content="Créer un compte" Click="ShowRegister" Style="{StaticResource PrimaryButton}"/><Button Content="Se connecter" Click="ShowLogin"/></WrapPanel>
<StackPanel x:Name="AccountForm" Visibility="Collapsed" IsEnabled="{Binding CommunityConfigured}"><TextBlock Text="Adresse email"/><TextBox x:Name="Email" AutomationProperties.Name="Email"/><StackPanel x:Name="RegistrationFields"><TextBlock Text="Username"/><TextBox x:Name="Username" AutomationProperties.Name="Username"/><TextBlock Text="Nom affiché"/><TextBox x:Name="DisplayName"/></StackPanel><TextBlock Text="Mot de passe"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8"/><ProgressBar x:Name="Strength" Maximum="3"/><TextBlock x:Name="StrengthText" Style="{StaticResource MutedText}"/><StackPanel x:Name="ConfirmationFields"><TextBlock Text="Confirmation"/><PasswordBox x:Name="Confirmation" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8"/><TextBlock x:Name="MatchText" Style="{StaticResource MutedText}"/></StackPanel><WrapPanel><Button x:Name="RegisterButton" Content="Créer mon compte" Click="Register"/><Button x:Name="LoginButton" Content="Connexion" Click="Login"/><Button Content="Mot de passe oublié" Click="Recover"/></WrapPanel></StackPanel></StackPanel></Border></StackPanel>
<TabControl Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}" Margin="0,16">
<TabItem Header="Profil public"><StackPanel Margin="20"><DockPanel><Grid DockPanel.Dock="Left" Width="104" Height="104" Margin="0,0,24,0"><Ellipse Fill="{DynamicResource AccentSoftBrush}"/><ui:CoverImage FilePath="{Binding ProfileAvatar}" Circular="True" Width="104" Height="104"/></Grid><StackPanel><TextBlock Text="{Binding ProfileName}" FontSize="30"/><TextBlock Text="{Binding ProfileUsername,StringFormat=@{0}}" Style="{StaticResource MutedText}"/><TextBlock Text="✓ Verified" Visibility="{Binding ProfileVerified,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ProfileBio}" Margin="0,10"/><TextBlock Text="{Binding ProfileMetrics}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel>
<Button Content="Actualiser le profil" Command="{Binding RefreshPublicProfileCommand}" HorizontalAlignment="Left"/>
<Expander Header="Modifier le profil public" Margin="0,18"><StackPanel><Button Content="Changer l’avatar" Command="{Binding ChangeAvatarCommand}" HorizontalAlignment="Left"/><TextBlock Text="Nom affiché"/><TextBox Text="{Binding ProfileName}" MaxLength="60"/><TextBlock Text="Username"/><TextBox Text="{Binding ProfileUsername}" MaxLength="24"/><TextBlock Text="Bio"/><TextBox Text="{Binding ProfileBio}" MaxLength="300" TextWrapping="Wrap" Height="80"/><Button Content="Enregistrer le profil public" Command="{Binding SaveOnlineProfileCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
<TextBlock Text="Publications" FontSize="22" Margin="0,12"/><ComboBox Width="210" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ProfilePublicationKind}"><ComboBoxItem Content="Publications" Tag="all"/><ComboBoxItem Content="Sounds" Tag="soundboard"/><ComboBoxItem Content="AI Voices" Tag="ai-voice"/><ComboBoxItem Content="Voice Presets" Tag="voice-preset"/></ComboBox>
<ItemsControl ItemsSource="{Binding ProfilePublications}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,8"><StackPanel><TextBlock Text="{Binding Title}" FontSize="18"/><TextBlock Text="{Binding Visibility}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Description}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Publish &amp; Share" Command="{Binding OpenPublicationCommand}"/>
</StackPanel></TabItem>
<TabItem Header="Confidentialité &amp; compte"><StackPanel Margin="20"><TextBlock Text="Adresse email" Style="{StaticResource Label}"/><TextBlock Text="{Binding ProfileEmail}" FontSize="18" Margin="0,8"/><CheckBox Content="Profil privé · demandes d’accès à approuver" IsChecked="{Binding ProfilePrivate}"/><Button Content="Enregistrer la confidentialité" Command="{Binding SaveProfilePrivacyCommand}" HorizontalAlignment="Left"/><TextBlock Text="Les publications gardent leur propre visibilité : Public, Friends Only, Unlisted ou Private." Style="{StaticResource MutedText}"/>
<Expander Header="Changer le mot de passe" Margin="0,20"><StackPanel><PasswordBox x:Name="NewPassword" Padding="10"/><PasswordBox x:Name="NewConfirmation" Padding="10" Margin="0,8"/><Button Content="Enregistrer le nouveau mot de passe" Click="ChangePassword"/></StackPanel></Expander><Button Content="Mot de passe oublié" Click="RecoverSignedIn" HorizontalAlignment="Left"/><Button Content="Déconnexion" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="Demandes d’accès" FontSize="20" Margin="0,20,0,8"/><Button Content="Actualiser" Command="{Binding RefreshSocialCommand}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding SocialContacts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Username,StringFormat=@{0}}"/><WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="request"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="Accepter" Command="{Binding DataContext.AcceptFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Refuser" Command="{Binding DataContext.DeclineFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></WrapPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="Supprimer mon compte" Command="{Binding DeleteAccountCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="0,24"/>
</StackPanel></TabItem></TabControl></StackPanel></UserControl>
