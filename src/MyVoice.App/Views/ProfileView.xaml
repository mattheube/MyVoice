<UserControl x:Class="MyVoice.App.Views.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="VOTRE IDENTITÉ" Style="{StaticResource Label}"/><TextBlock Text="Profile" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}" Margin="0,24"><StackPanel><Grid Height="100"><Ellipse Fill="{DynamicResource AccentSoftBrush}" Width="96" Height="96"/><ui:CoverImage FilePath="{Binding ProfileAvatar}" Width="96" Height="96" Circular="True" Stretch="UniformToFill"/></Grid><Button Content="Changer mon avatar" Command="{Binding ChangeAvatarCommand}" HorizontalAlignment="Center"/><TextBlock Text="Nom affiché · profil local" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=LostFocus}" MaxLength="60"/><TextBlock Text="Bio" Style="{StaticResource Label}"/><TextBox Text="{Binding ProfileBio,UpdateSourceTrigger=LostFocus}" MaxLength="300" TextWrapping="Wrap" Height="90"/><TextBlock Text="Enregistré sur votre PC. Aucun compte en ligne n’est créé par ce formulaire." Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compte MyVoice" FontSize="22"/><TextBlock Text="{Binding AccountStatus}" Style="{StaticResource MutedText}"/><StackPanel IsEnabled="{Binding CommunityConfigured}"><TextBlock Text="Email"/><TextBox x:Name="Email" AutomationProperties.Name="Email"/><TextBlock Text="Username · unique, 3–24 caractères"/><TextBox x:Name="Username" AutomationProperties.Name="Username"/><TextBlock Text="Nom affiché · peut être partagé avec d’autres personnes"/><TextBox x:Name="DisplayName" Text="{Binding ProfileName}"/><TextBlock Text="Mot de passe · 10 caractères minimum, 12 ou plus conseillé"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"/><ProgressBar x:Name="Strength" Maximum="3"/><TextBlock x:Name="StrengthText" Style="{StaticResource MutedText}"/><TextBlock Text="Confirmer le mot de passe"/><PasswordBox x:Name="Confirmation" PasswordChanged="PasswordChanged" Padding="10" Margin="0,8" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="MatchText" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Créer un compte" Click="Register" Style="{StaticResource PrimaryButton}"/><Button Content="Se connecter" Click="Login"/><Button Content="Mot de passe oublié" Click="Recover"/></WrapPanel><CheckBox Content="Profil privé · demande de suivi nécessaire" IsChecked="{Binding ProfilePrivate}"/><WrapPanel><Button Content="Enregistrer le profil en ligne" Command="{Binding SaveOnlineProfileCommand}"/><Button Content="Se déconnecter" Command="{Binding LogoutCommand}"/></WrapPanel></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshSocialCommand}"/><TextBlock Text="Amis et demandes" FontSize="22"/></DockPanel><TextBlock Text="{Binding SocialCounts}" Style="{StaticResource MutedText}"/><TextBlock Text="Les amis apparaissent lorsque vous vous suivez mutuellement. Un profil privé reçoit des demandes à accepter." Style="{StaticResource MutedText}"/><ItemsControl ItemsSource="{Binding SocialContacts}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16"/><TextBlock Text="{Binding Username,StringFormat=@{0}}"/><WrapPanel><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="request"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="Accepter" Command="{Binding DataContext.AcceptFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Refuser" Command="{Binding DataContext.DeclineFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></UserControl>
