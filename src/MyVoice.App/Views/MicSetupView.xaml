<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MyVoice.App.Views.MicSetupView"><StackPanel><TextBlock Text="RÉGLER, ÉCOUTER, PARLER" Style="{StaticResource Label}" /><TextBlock Text="Votre micro, à votre façon." Style="{StaticResource Heading}" /><TextBlock Text="Une seule place pour le niveau, le nettoyage et l’écoute." Style="{StaticResource MutedText}" />
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microphone utilisé" FontSize="18" /><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}" /><Button Content="Destinations et écoute → Mixer" Command="{Binding NavigateCommand}" CommandParameter="8" HorizontalAlignment="Left" /><TextBlock Text="Le nettoyage et la voix se règlent ici. Les sorties, volumes de mix et destinations sont dans Mixer." Style="{StaticResource MutedText}" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Niveau d’entrée" FontSize="18" /><ui:SignalHistory Level="{Binding Meter}" Height="74" /><TextBlock Text="{Binding GainLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="24" /><Slider Value="{Binding GainDb}" Minimum="-20" Maximum="30" ToolTip="Ajuste l’entrée. Bas : moins fort ; haut : plus fort. Départ conseillé : 0 dB." /><Button Content="Réinitialiser le niveau" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" /></StackPanel><StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="Écoutez le résultat" FontSize="18" /><TextBlock Text="{Binding LevelText}" Style="{StaticResource MutedText}" /><Button Content="Calibrer mon microphone" Command="{Binding CalibrateCommand}" /><TextBlock Text="{Binding CalibrationText}" Style="{StaticResource MutedText}" /><WrapPanel Visibility="{Binding CanApply,Converter={StaticResource BoolVisibility}}"><Button Content="Appliquer" Command="{Binding ApplyCalibrationCommand}" /><Button Content="Conserver" Command="{Binding KeepCalibrationCommand}" /></WrapPanel><CheckBox Content="Contrôles avancés" IsChecked="{Binding AdvancedMicrophone}" /></StackPanel></Grid></Border><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding T[Processing]}" FontSize="18" FontWeight="SemiBold" /><Button Content="{Binding T[Restore]}" Command="{Binding ResetProcessingCommand}" HorizontalAlignment="Right" /></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

 <StackPanel Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Noise Gate" ToolTip="{Binding T[GateTip]}" IsChecked="{Binding Gate}" /><ui:HelpButton ToolTip="{Binding T[GateTip]}" /></StackPanel><TextBlock Text="{Binding GateThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}" /><Slider ToolTip="{Binding T[GateTip]}" Value="{Binding GateThreshold}" Minimum="-70" Maximum="-10" /><Expander Header="{Binding T[Advanced]}" IsExpanded="{Binding AdvancedMicrophone}"><StackPanel><TextBlock Text="Attack (ms)" /><Slider Value="{Binding GateAttack}" Minimum="1" Maximum="50" /><TextBlock Text="Release (ms)" /><Slider Value="{Binding GateRelease}" Minimum="20" Maximum="500" /></StackPanel></Expander></StackPanel>

 <StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Compressor" ToolTip="{Binding T[CompressorTip]}" IsChecked="{Binding Compressor}" /><ui:HelpButton ToolTip="{Binding T[CompressorTip]}" /></StackPanel><TextBlock Text="{Binding CompressorThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}" /><Slider Value="{Binding CompressorThreshold}" Minimum="-40" Maximum="-6" /><TextBlock Text="{Binding CompressorRatio,StringFormat=Ratio {0:0.0}:1}" Style="{StaticResource MutedText}" /><Slider ToolTip="{Binding T[CompressorTip]}" Value="{Binding CompressorRatio}" Minimum="1" Maximum="8" /></StackPanel>

 <StackPanel Grid.Column="2" Margin="7,0,0,0"><TextBlock Text="{Binding T[NoiseReduction]}" Margin="0,8,0,8" /><ComboBox SelectedIndex="{Binding NoiseSuppression}"><ComboBoxItem Content="Off" /><ComboBoxItem Content="Low" /><ComboBoxItem Content="Medium" /><ComboBoxItem Content="High" /></ComboBox><CheckBox Content="Auto Gain" IsChecked="{Binding AutoGain}" /><TextBlock Text="{Binding T[LimiterNote]}" Style="{StaticResource MutedText}" /></StackPanel></Grid>

 <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Button Content="Reset EQ" Command="{Binding ResetEqCommand}" /><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[BassTip]}" Text="BASS" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[BassTip]}" /></StackPanel><Slider ToolTip="{Binding T[BassTip]}" Value="{Binding Bass}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Bass,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel><StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[MidTip]}" Text="MID" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[MidTip]}" /></StackPanel><Slider ToolTip="{Binding T[MidTip]}" Value="{Binding Mid}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Mid,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel><StackPanel Grid.Column="2" Margin="7,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[TrebleTip]}" Text="TREBLE" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[TrebleTip]}" /></StackPanel><Slider ToolTip="{Binding T[TrebleTip]}" Value="{Binding Treble}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Treble,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel></Grid>

 </StackPanel></Border>

 <Border Style="{StaticResource Card}" Visibility="{Binding AdvancedMicrophone,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Dynamics · Advanced" FontSize="20" /><StackPanel Orientation="Horizontal"><TextBlock Text="Gate Hold (ms)" /><ui:HelpButton ToolTip="Temps avant fermeture : bas coupe vite, haut garde les fins de mots. Conseillé : 100 ms." /></StackPanel><Slider Value="{Binding GateHold}" Minimum="0" Maximum="500" /><TextBlock Text="{Binding GateHold,StringFormat=F1}" /><StackPanel Orientation="Horizontal"><TextBlock Text="Compressor Attack (ms)" /><ui:HelpButton ToolTip="Réaction : bas contrôle les attaques, haut les préserve. Conseillé : 8 ms." /></StackPanel><Slider Value="{Binding CompressorAttack}" Minimum="1" Maximum="100" /><TextBlock Text="{Binding CompressorAttack,StringFormat=F1}" /><StackPanel Orientation="Horizontal"><TextBlock Text="Compressor Release (ms)" /><ui:HelpButton ToolTip="Retour au gain normal : bas réagit vite, haut lisse davantage. Conseillé : 150 ms." /></StackPanel><Slider Value="{Binding CompressorRelease}" Minimum="20" Maximum="1000" /><TextBlock Text="{Binding CompressorRelease,StringFormat=F1}" /><StackPanel Orientation="Horizontal"><TextBlock Text="Makeup gain (dB)" /><ui:HelpButton ToolTip="Gain après compression : bas atténue, haut renforce. Conseillé : 0 dB." /></StackPanel><Slider Value="{Binding MakeupGain}" Minimum="-12" Maximum="18" /><TextBlock Text="{Binding MakeupGain,StringFormat=F1}" /><WrapPanel><Button Content="Reset Bass" Command="{Binding ResetMicControlCommand}" CommandParameter="Bass" /><Button Content="Reset Mid" Command="{Binding ResetMicControlCommand}" CommandParameter="Mid" /><Button Content="Reset Treble" Command="{Binding ResetMicControlCommand}" CommandParameter="Treble" /><Button Content="Reset Gate" Command="{Binding ResetMicControlCommand}" CommandParameter="Gate" /><Button Content="Reset Compressor" Command="{Binding ResetMicControlCommand}" CommandParameter="Compressor" /></WrapPanel></StackPanel></Border></StackPanel></UserControl>