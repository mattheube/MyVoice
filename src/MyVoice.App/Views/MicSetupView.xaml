<UserControl x:Class="MyVoice.App.Views.MicSetupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="RÉGLER, ÉCOUTER, PARLER" Style="{StaticResource Label}"/><TextBlock Text="Votre micro, à votre façon." Style="{StaticResource Heading}"/><TextBlock Text="Une seule place pour le niveau, le nettoyage et l’écoute." Style="{StaticResource MutedText}"/>
<Border Style="{StaticResource Card}" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Niveau d’entrée" FontSize="18"/><ui:SignalHistory Level="{Binding Meter}" Height="74"/><TextBlock Text="{Binding GainLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="24"/><Slider Value="{Binding GainDb}" Minimum="-20" Maximum="30" ToolTip="Ajuste l’entrée. Bas : moins fort ; haut : plus fort. Départ conseillé : 0 dB."/><Button Content="Réinitialiser le niveau" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="Écoutez le résultat" FontSize="18"/><CheckBox Content="Hear Myself" IsChecked="{Binding HearMyself}"/><TextBlock Text="{Binding LevelText}" Style="{StaticResource MutedText}"/><Button Content="Calibrer mon microphone" Command="{Binding CalibrateCommand}"/><TextBlock Text="{Binding CalibrationText}" Style="{StaticResource MutedText}"/><WrapPanel Visibility="{Binding CanApply,Converter={StaticResource BoolVisibility}}"><Button Content="Appliquer" Command="{Binding ApplyCalibrationCommand}"/><Button Content="Conserver" Command="{Binding KeepCalibrationCommand}"/></WrapPanel><CheckBox Content="Contrôles avancés" IsChecked="{Binding AdvancedMicrophone}"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Margin="0,16,0,14"><StackPanel><DockPanel><TextBlock Text="{Binding T[Routing]}" FontSize="18" FontWeight="SemiBold" /><Button Content="↻" Command="{Binding RefreshOutputsCommand}" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="{Binding T[Input]}" Style="{StaticResource Label}" /><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding T[MonitoringDevice]}" Style="{StaticResource Label}" /><ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding MonitoringDevice}" ItemTemplate="{StaticResource DeviceTemplate}" /><Slider Value="{Binding MonitoringVolumeSlider}" Maximum="200" AutomationProperties.Name="Headphone volume" /><TextBox Text="{Binding MonitoringVolume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="Volume du casque en %. La saisie numérique peut dépasser le curseur." /></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding T[VirtualDevice]}" Style="{StaticResource Label}" /><TextBlock Text="VB-Audio Virtual Cable"/><TextBlock Text="{Binding CableStatus}" Style="{StaticResource MutedText}"/><CheckBox Content="{Binding T[SendMicrophone]}" IsChecked="{Binding SendMicrophone}" /></StackPanel></Grid><TextBlock Text="{Binding T[VirtualHelp]}" Style="{StaticResource MutedText}" /><Button Content="{Binding T[GetCable]}" Command="{Binding OpenCableWebsiteCommand}" HorizontalAlignment="Left" /></StackPanel></Border>

 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="{Binding T[Processing]}" FontSize="18" FontWeight="SemiBold" /><Button Content="{Binding T[Restore]}" Command="{Binding ResetProcessingCommand}" HorizontalAlignment="Right" /></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

 <StackPanel Margin="0,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Noise Gate" ToolTip="{Binding T[GateTip]}" IsChecked="{Binding Gate}" /><ui:HelpButton ToolTip="{Binding T[GateTip]}" /></StackPanel><TextBlock Text="{Binding GateThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}" /><Slider ToolTip="{Binding T[GateTip]}" Value="{Binding GateThreshold}" Minimum="-70" Maximum="-10" /><Expander Header="{Binding T[Advanced]}" IsExpanded="{Binding AdvancedMicrophone}"><StackPanel><TextBlock Text="Attack (ms)" /><Slider Value="{Binding GateAttack}" Minimum="1" Maximum="50" /><TextBlock Text="Release (ms)" /><Slider Value="{Binding GateRelease}" Minimum="20" Maximum="500" /></StackPanel></Expander></StackPanel>

 <StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><CheckBox Content="Compressor" ToolTip="{Binding T[CompressorTip]}" IsChecked="{Binding Compressor}" /><ui:HelpButton ToolTip="{Binding T[CompressorTip]}" /></StackPanel><TextBlock Text="{Binding CompressorThreshold,StringFormat={}{0:0} dB}" Style="{StaticResource MutedText}" /><Slider Value="{Binding CompressorThreshold}" Minimum="-40" Maximum="-6" /><TextBlock Text="{Binding CompressorRatio,StringFormat=Ratio {0:0.0}:1}" Style="{StaticResource MutedText}" /><Slider ToolTip="{Binding T[CompressorTip]}" Value="{Binding CompressorRatio}" Minimum="1" Maximum="8" /></StackPanel>

 <StackPanel Grid.Column="2" Margin="7,0,0,0"><TextBlock Text="{Binding T[NoiseReduction]}" Margin="0,8,0,8" /><ComboBox SelectedIndex="{Binding NoiseSuppression}"><ComboBoxItem Content="Off" /><ComboBoxItem Content="Low" /><ComboBoxItem Content="Medium" /><ComboBoxItem Content="High" /></ComboBox><CheckBox Content="Auto Gain" IsChecked="{Binding AutoGain}" /><TextBlock Text="{Binding T[LimiterNote]}" Style="{StaticResource MutedText}" /></StackPanel></Grid>

 <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Button Content="Reset EQ" Command="{Binding ResetEqCommand}" /><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[BassTip]}" Text="BASS" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[BassTip]}" /></StackPanel><Slider ToolTip="{Binding T[BassTip]}" Value="{Binding Bass}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Bass,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel><StackPanel Grid.Column="1" Margin="7,0,14,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[MidTip]}" Text="MID" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[MidTip]}" /></StackPanel><Slider ToolTip="{Binding T[MidTip]}" Value="{Binding Mid}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Mid,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel><StackPanel Grid.Column="2" Margin="7,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding T[TrebleTip]}" Text="TREBLE" Style="{StaticResource Label}" /><ui:HelpButton ToolTip="{Binding T[TrebleTip]}" /></StackPanel><Slider ToolTip="{Binding T[TrebleTip]}" Value="{Binding Treble}" Minimum="-12" Maximum="12" /><TextBlock Text="{Binding Treble,StringFormat={}{0:+0.0;-0.0;0.0} dB}" Style="{StaticResource MutedText}" /></StackPanel></Grid>

 </StackPanel></Border>

 <Border Style="{StaticResource Card}" Visibility="{Binding AdvancedMicrophone,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Dynamics · Advanced" FontSize="20"/><StackPanel Orientation="Horizontal"><TextBlock Text="Gate Hold (ms)"/><ui:HelpButton ToolTip="Temps avant fermeture : bas coupe vite, haut garde les fins de mots. Conseillé : 100 ms."/></StackPanel><Slider Value="{Binding GateHold}" Minimum="0" Maximum="500"/><TextBlock Text="{Binding GateHold,StringFormat=F1}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Compressor Attack (ms)"/><ui:HelpButton ToolTip="Réaction : bas contrôle les attaques, haut les préserve. Conseillé : 8 ms."/></StackPanel><Slider Value="{Binding CompressorAttack}" Minimum="1" Maximum="100"/><TextBlock Text="{Binding CompressorAttack,StringFormat=F1}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Compressor Release (ms)"/><ui:HelpButton ToolTip="Retour au gain normal : bas réagit vite, haut lisse davantage. Conseillé : 150 ms."/></StackPanel><Slider Value="{Binding CompressorRelease}" Minimum="20" Maximum="1000"/><TextBlock Text="{Binding CompressorRelease,StringFormat=F1}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Makeup gain (dB)"/><ui:HelpButton ToolTip="Gain après compression : bas atténue, haut renforce. Conseillé : 0 dB."/></StackPanel><Slider Value="{Binding MakeupGain}" Minimum="-12" Maximum="18"/><TextBlock Text="{Binding MakeupGain,StringFormat=F1}"/><WrapPanel><Button Content="Reset Bass" Command="{Binding ResetMicControlCommand}" CommandParameter="Bass"/><Button Content="Reset Mid" Command="{Binding ResetMicControlCommand}" CommandParameter="Mid"/><Button Content="Reset Treble" Command="{Binding ResetMicControlCommand}" CommandParameter="Treble"/><Button Content="Reset Gate" Command="{Binding ResetMicControlCommand}" CommandParameter="Gate"/><Button Content="Reset Compressor" Command="{Binding ResetMicControlCommand}" CommandParameter="Compressor"/></WrapPanel></StackPanel></Border><Expander Header="Diagnostic du parcours audio"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Audio Test" FontSize="18" /><TextBlock Text="Volume global des soundboards (%)" Margin="0,12,0,0" /><Slider Value="{Binding SoundboardVolumeSlider}" Maximum="400" /><TextBox Text="{Binding SoundboardVolume,StringFormat=F0,ValidatesOnExceptions=True}" ToolTip="La saisie peut dépasser 400 %. Le limiteur de sortie reste actif." /><TextBlock Text="{Binding RouteStatus}" Style="{StaticResource MutedText}" /><UniformGrid Columns="4"><StackPanel Margin="0,8,12,8"><TextBlock Text="Physical mic" /><ProgressBar Value="{Binding Meter}" Margin="0,10" /></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Processed mic" /><ProgressBar Value="{Binding ProcessedMeter}" Margin="0,10" /></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Virtual mix" /><ProgressBar Value="{Binding OutputMeter}" Margin="0,10" /></StackPanel><StackPanel Margin="0,8,12,8"><TextBlock Text="Headphones" /><ProgressBar Value="{Binding MonitorMeter}" Margin="0,10" /></StackPanel></UniformGrid><Button Content="Test Virtual Output · 1 s" Command="{Binding TestVirtualOutputCommand}" HorizontalAlignment="Left" /></StackPanel></Border>

 <TextBlock Text="Microphone → Traitement → Voix → Mixer → Câble virtuel" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding AiState}"/></StackPanel></Expander><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dans Discord ou votre jeu" FontSize="18"/><TextBlock Text="Choisissez CABLE Output (VB-Audio Virtual Cable) comme microphone." Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Copier le nom" Command="{Binding CopyCableNameCommand}"/><Button Content="Revérifier le câble" Command="{Binding RefreshCableCommand}"/></WrapPanel><TextBlock Text="VB-CABLE par VB-Audio · Donationware. Installez depuis le site officiel si le câble est absent ; Windows peut demander un redémarrage." Style="{StaticResource MutedText}"/></StackPanel></Border><Button Content="{Binding T[ResetAll]}" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left" /></StackPanel></UserControl>
