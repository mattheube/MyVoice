<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MyVoice.App.Views.MicSetupView"><StackPanel>
<TextBlock Text="MIC SETUP / LE SON À LA SOURCE" Style="{StaticResource Label}"/><DockPanel><CheckBox DockPanel.Dock="Right" Content="Advanced" IsChecked="{Binding AdvancedMicrophone}"/><TextBlock Text="Votre micro, à votre façon." Style="{StaticResource Heading}"/></DockPanel>
<TextBlock Text="Réglez votre voix en écoutant le résultat. Chaque traitement agit avant l’envoi au Mixer." Style="{StaticResource MutedText}"/>
<WrapPanel Margin="0,14,0,18">
<Button Content="Natural" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Natural"/>
<Button Content="Clear Voice" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Clear Voice"/>
<Button Content="Broadcast" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Broadcast"/>
<Button Content="Distant Microphone" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Distant Microphone"/>
<Button Content="Quiet Room" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Quiet Room"/>
<Button Content="Noisy Room" Command="{Binding ApplyMicPresetCommand}" CommandParameter="Noisy Room"/>
</WrapPanel>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01 / INPUT" Style="{StaticResource Label}"/><TextBlock Text="Votre microphone" FontSize="22"/><ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ItemTemplate="{StaticResource DeviceTemplate}"/><ui:SignalHistory Level="{Binding Meter}" Height="60"/><TextBlock Text="{Binding LevelText}" Style="{StaticResource MutedText}"/>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Augmente le niveau d’entrée. Commencez à 0 dB ; utilisez la calibration pour éviter la saturation."/><TextBlock Text="Input Gain"/><TextBlock Text="{Binding GainDb,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding GainDb}" Minimum="-20" Maximum="30" AutomationProperties.Name="Input Gain"/></StackPanel>
<WrapPanel><Button Content="Calibrer" Command="{Binding CalibrateCommand}"/><Button Content="Reset gain" Command="{Binding RestoreCommand}"/></WrapPanel><TextBlock Text="{Binding CalibrationText}" Style="{StaticResource MutedText}"/><WrapPanel Visibility="{Binding CanApply,Converter={StaticResource BoolVisibility}}"><Button Content="Appliquer" Command="{Binding ApplyCalibrationCommand}"/><Button Content="Conserver" Command="{Binding KeepCalibrationCommand}"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetMicSectionCommand}" CommandParameter="Cleanup"/><TextBlock Text="02 / CLEANUP" FontSize="20" VerticalAlignment="Center"/></DockPanel>
<Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Réduit les bruits réguliers. Un réglage élevé peut modifier le timbre ; commencez par Low."/><TextBlock Text="Noise Reduction" FontSize="16"/></DockPanel><ComboBox SelectedIndex="{Binding NoiseSuppression}"><ComboBoxItem Content="Off"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><CheckBox Content="Noise Gate" IsChecked="{Binding Gate}"/>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Coupe les sons très faibles. Un seuil plus haut retire davantage de bruit mais peut couper les mots prononcés doucement."/><TextBlock Text="Seuil du gate"/><TextBlock Text="{Binding GateThreshold,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding GateThreshold}" Minimum="-70" Maximum="-10" AutomationProperties.Name="Seuil du gate"/></StackPanel>
</StackPanel></Grid>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetMicSectionCommand}" CommandParameter="Tone"/><TextBlock Text="03 / TONE" FontSize="20" VerticalAlignment="Center"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,18,0">
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Graves : ajoute du corps ou réduit une voix trop sourde."/><TextBlock Text="Bass"/><TextBlock Text="{Binding Bass,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding Bass}" Minimum="-12" Maximum="12" AutomationProperties.Name="Bass"/></StackPanel>
</StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,18,0">
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Médiums : ajuste la présence de la voix."/><TextBlock Text="Mid"/><TextBlock Text="{Binding Mid,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding Mid}" Minimum="-12" Maximum="12" AutomationProperties.Name="Mid"/></StackPanel>
</StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,18,0">
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Aigus : ajoute de la clarté, mais peut renforcer les sifflantes."/><TextBlock Text="Treble"/><TextBlock Text="{Binding Treble,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding Treble}" Minimum="-12" Maximum="12" AutomationProperties.Name="Treble"/></StackPanel>
</StackPanel>
</Grid>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetMicSectionCommand}" CommandParameter="Dynamics"/><TextBlock Text="04 / DYNAMICS" FontSize="20" VerticalAlignment="Center"/></DockPanel>
<WrapPanel><CheckBox Content="Compressor" IsChecked="{Binding Compressor}"/><ui:HelpButton ToolTip="Réduit les écarts entre les passages forts et faibles. Le gain de sortie peut ensuite compenser le niveau."/><CheckBox Content="Auto Gain" IsChecked="{Binding AutoGain}" Margin="24,8,0,8"/><ui:HelpButton ToolTip="Ajuste progressivement le niveau de parole. Peut amplifier le bruit de fond ; laissez désactivé si votre niveau est régulier."/></WrapPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Le compresseur agit sur les sons au-dessus de ce niveau."/><TextBlock Text="Seuil de compression"/><TextBlock Text="{Binding CompressorThreshold,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding CompressorThreshold}" Minimum="-40" Maximum="-6" AutomationProperties.Name="Seuil de compression"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Plus le ratio est élevé, plus les passages forts sont réduits. Départ conseillé : 3:1."/><TextBlock Text="Ratio"/><TextBlock Text="{Binding CompressorRatio,StringFormat={}{0:0.#} :1}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding CompressorRatio}" Minimum="1" Maximum="8" AutomationProperties.Name="Ratio"/></StackPanel>
<TextBlock Text="Limiteur de sortie toujours actif · protège le mix de la saturation numérique." Style="{StaticResource MutedText}"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetMicSectionCommand}" CommandParameter="Monitoring"/><TextBlock Text="05 / MONITORING" FontSize="20" VerticalAlignment="Center"/></DockPanel>
<CheckBox Content="Entendre ma voix" IsChecked="{Binding HearMyself}"/><ProgressBar Value="{Binding MonitorMeter}"/><Button Content="Choisir mon casque dans Mixer →" Command="{Binding NavigateCommand}" CommandParameter="8" HorizontalAlignment="Left"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Visibility="{Binding AdvancedMicrophone,Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="06 / ADVANCED" FontSize="20"/>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Vitesse d’ouverture du gate. Conseillé : 5 ms."/><TextBlock Text="Gate attack"/><TextBlock Text="{Binding GateAttack,StringFormat={}{0:0.#} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding GateAttack}" Minimum="1" Maximum="50" AutomationProperties.Name="Gate attack"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Durée minimale de maintien, pour préserver les fins de mots. Conseillé : 100 ms."/><TextBlock Text="Gate hold"/><TextBlock Text="{Binding GateHold,StringFormat={}{0:0.#} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding GateHold}" Minimum="0" Maximum="500" AutomationProperties.Name="Gate hold"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Vitesse de fermeture du gate. Conseillé : 120 ms."/><TextBlock Text="Gate release"/><TextBlock Text="{Binding GateRelease,StringFormat={}{0:0.#} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding GateRelease}" Minimum="20" Maximum="500" AutomationProperties.Name="Gate release"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Temps de réaction à une attaque forte. Conseillé : 8 ms."/><TextBlock Text="Compressor attack"/><TextBlock Text="{Binding CompressorAttack,StringFormat={}{0:0.#} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding CompressorAttack}" Minimum="1" Maximum="100" AutomationProperties.Name="Compressor attack"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Retour progressif au gain normal. Conseillé : 150 ms."/><TextBlock Text="Compressor release"/><TextBlock Text="{Binding CompressorRelease,StringFormat={}{0:0.#} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding CompressorRelease}" Minimum="20" Maximum="1000" AutomationProperties.Name="Compressor release"/></StackPanel>
<StackPanel Margin="0,10,0,0"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Gain après compression. Commencez à 0 dB."/><TextBlock Text="Makeup gain"/><TextBlock Text="{Binding MakeupGain,StringFormat={}{0:0.#} dB}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel><Slider Value="{Binding MakeupGain}" Minimum="-12" Maximum="18" AutomationProperties.Name="Makeup gain"/></StackPanel>
</StackPanel></Border>
<Button Content="Restore Recommended" Command="{Binding ResetProcessingCommand}" HorizontalAlignment="Left"/></StackPanel></UserControl>