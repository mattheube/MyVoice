<UserControl x:Class="MyVoice.App.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui305],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding Welcome}" FontSize="38" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource MutedText}"/>
<Border CornerRadius="24" Margin="0,24,0,28" Padding="28" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"><Border.Background><DynamicResource ResourceKey="AccentSoftBrush"/></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DataContext.T[Ui606],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/><TextBlock Text="{Binding DataContext.T[Ui306],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,10"/><TextBlock Text="{Binding DataContext.T[Ui530],RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource MutedBrush}" LineHeight="23"/><WrapPanel Margin="0,18,0,0"><Button Content="{Binding DataContext.T[Ui506],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NavigateCommand}" CommandParameter="0" Style="{StaticResource PrimaryButton}"/><Button Content="{Binding DataContext.T[OpenBuilder],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NavigateCommand}" CommandParameter="2"/></WrapPanel></StackPanel><Grid Grid.Column="1" Margin="12"><Ellipse Stroke="{DynamicResource LineBrush}" Width="174" Height="174"/><Ellipse Stroke="{DynamicResource AccentBrush}" Width="130" Height="130"/><ui:BrandMark Width="130" Height="90"/><Ellipse Fill="{DynamicResource AccentBrush}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,30,0"/></Grid></Grid></Border>
<TextBlock Text="{Binding DataContext.T[Ui307],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,14,16"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui308],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastVoiceName}" FontSize="22"/><Button Content="{Binding DataContext.T[Ui309],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding QuickSwitchVoiceCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui310],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastSoundName}" FontSize="22"/><Button Content="{Binding DataContext.T[Ui311],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenLastSoundCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></Grid>
<DockPanel Margin="0,16,0,14"><Button Content="{Binding DataContext.T[Ui312],RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Command="{Binding CreateBoardInStudioCommand}"/><TextBlock Text="{Binding DataContext.T[Ui313],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Folders}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="210" Height="108" Margin="0,0,14,14" Command="{Binding DataContext.OpenBoardCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui314],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Name}" FontSize="19" Margin="0,12,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Card}" Margin="0,18,0,0"><DockPanel><Button Content="{Binding DataContext.T[Ui315],RelativeSource={RelativeSource AncestorType=Window}}" DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="5"/><StackPanel><TextBlock Text="{Binding DataContext.T[Ui316],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="19"/><TextBlock Text="{Binding DataContext.T[Ui317],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/></StackPanel></DockPanel></Border></StackPanel></UserControl>
