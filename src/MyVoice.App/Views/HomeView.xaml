<UserControl x:Class="MyVoice.App.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="VOTRE ESPACE AUDIO" Style="{StaticResource Label}"/><TextBlock Text="{Binding Welcome}" FontSize="38" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource MutedText}"/>
<Border CornerRadius="24" Margin="0,24,0,28" Padding="28" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#352D54"/><GradientStop Color="#1B2633" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR VOICE. YOUR SOUND." Foreground="#C8BDF2" FontSize="10"/><TextBlock Text="Faites-vous entendre." Foreground="#F5F1FF" FontSize="30" FontWeight="SemiBold" Margin="0,14,0,10"/><TextBlock Text="Retrouvez vos voix et vos sons.
Créez quelque chose qui vous ressemble." Foreground="#C9C3D7" LineHeight="23"/><WrapPanel Margin="0,18,0,0"><Button Content="Choisir une voix  →" Command="{Binding NavigateCommand}" CommandParameter="0" Style="{StaticResource PrimaryButton}"/><Button Content="Ouvrir Studio" Command="{Binding NavigateCommand}" CommandParameter="2"/></WrapPanel></StackPanel><Grid Grid.Column="1" Margin="12"><Ellipse Stroke="#4A4164" Width="174" Height="174"/><Ellipse Stroke="#66577D" Width="130" Height="130"/><ui:BrandMark Width="130" Height="90"/><Ellipse Fill="#D0BEFF" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,30,0"/></Grid></Grid></Border>
<TextBlock Text="Reprendre là où vous étiez" FontSize="21" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,14,16"><StackPanel><TextBlock Text="DERNIÈRE VOIX" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastVoiceName}" FontSize="22"/><Button Content="Clean ↔ Dernière voix" Command="{Binding QuickSwitchVoiceCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="DERNIER SON" Style="{StaticResource Label}"/><TextBlock Text="{Binding LastSoundName}" FontSize="22"/><Button Content="Afficher le son" Command="{Binding OpenLastSoundCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></Grid>
<DockPanel Margin="0,16,0,14"><Button Content="Nouveau Soundboard" DockPanel.Dock="Right" Command="{Binding CreateBoardInStudioCommand}"/><TextBlock Text="Vos Soundboards" FontSize="21" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Folders}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="210" Height="108" Margin="0,0,14,14" Command="{Binding DataContext.OpenBoardCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="◒  COLLECTION LOCALE" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Name}" FontSize="19" Margin="0,12,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Style="{StaticResource Card}" Margin="0,18,0,0"><DockPanel><Button Content="Découvrir Community →" DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="5"/><StackPanel><TextBlock Text="Un espace pour les créateurs" FontSize="19"/><TextBlock Text="Les fonctions locales sont toujours disponibles, même hors ligne." Style="{StaticResource MutedText}"/></StackPanel></DockPanel></Border></StackPanel></UserControl>
