<UserControl x:Class="MyVoice.App.Views.StudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="LE LABORATOIRE DES CRÉATEURS" Style="{StaticResource Label}"/><TextBlock Text="Studio" Style="{StaticResource Heading}"/><TabControl SelectedIndex="{Binding StudioTab}" Margin="0,24,0,0"><TabItem Header="Soundboard Builder"><StackPanel><TextBlock Text="Soundboard Builder" FontSize="24"/><TextBlock Text="Une collection pour vos sessions, vos amis, vos réactions." Style="{StaticResource MutedText}"/><WrapPanel Margin="0,16"><Button Content="Créer un Soundboard" Command="{Binding CreateFolderCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Importer des sons" Command="{Binding ImportSoundsCommand}"/></WrapPanel><ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name"/><WrapPanel><Button Content="Renommer" Command="{Binding RenameFolderCommand}"/><Button Content="Cover" Command="{Binding ChangeFolderCoverCommand}"/><Button Content="Dupliquer" Command="{Binding DuplicateFolderCommand}"/><Button Content="Ouvrir dans Soundboard" Command="{Binding NavigateCommand}" CommandParameter="1"/></WrapPanel><TextBlock Text="Vos fichiers ne sont jamais partagés automatiquement." Style="{StaticResource MutedText}"/><Button Content="Exporter un package" Command="{Binding ExportBoardCommand}" HorizontalAlignment="Left"/></StackPanel></TabItem><TabItem Header="Voice Lab"><views:VoiceLabView/></TabItem><TabItem Header="Voice Designer"><StackPanel><TextBlock Text="Voice Designer" FontSize="24"/><TextBlock Text="Un preset classique, construit avec des effets locaux." Style="{StaticResource MutedText}"/><TextBox Text="{Binding DesignerName}"/><TextBlock Text="BASE" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DesignerBases}" SelectedItem="{Binding DesignerBase}"/><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Hauteur : 0,5 grave, 2 aigu. Naturel : 1."/><StackPanel><TextBlock Text="Pitch" FontSize="16"/><Slider Value="{Binding DesignerPitch}" Minimum="0.5" Maximum="2"/><TextBlock Text="{Binding DesignerPitch,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Graves : négatif allège, positif épaissit. Départ : 0 dB."/><StackPanel><TextBlock Text="Bass" FontSize="16"/><Slider Value="{Binding DesignerBass}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding DesignerBass,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Médiums : négatif creuse, positif rapproche. Départ : 0 dB."/><StackPanel><TextBlock Text="Mid" FontSize="16"/><Slider Value="{Binding DesignerMid}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding DesignerMid,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Aigus : négatif adoucit, positif éclaircit. Départ : 0 dB."/><StackPanel><TextBlock Text="Treble" FontSize="16"/><Slider Value="{Binding DesignerTreble}" Minimum="-12" Maximum="12"/><TextBlock Text="{Binding DesignerTreble,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Saturation : 0 désactive, 100 fortement écrêté. Départ : 0 %."/><StackPanel><TextBlock Text="Distortion" FontSize="16"/><Slider Value="{Binding DesignerDistortion}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding DesignerDistortion,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Écho : 0 désactive, 100 très présent. Départ : 0 %."/><StackPanel><TextBlock Text="Delay" FontSize="16"/><Slider Value="{Binding DesignerDelay}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding DesignerDelay,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Border Style="{StaticResource Card}"><DockPanel><ui:HelpButton DockPanel.Dock="Right" ToolTip="Mélange : 0 voix sèche, 100 effet complet. Départ : 100 %."/><StackPanel><TextBlock Text="Mix" FontSize="16"/><Slider Value="{Binding DesignerMix}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding DesignerMix,StringFormat=F2}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Border><Button Content="Enregistrer dans mes voix" Command="{Binding SaveDesignedVoiceCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></TabItem></TabControl></StackPanel></UserControl>
