<UserControl x:Class="MyVoice.App.Views.VoiceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui477],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="{Binding DataContext.T[Ui478],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding GoVoiceLabCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="{Binding DataContext.T[Ui602],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{Binding DataContext.T[Ui479],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/>
<DockPanel Margin="0,16"><CheckBox DockPanel.Dock="Right" Content="{Binding DataContext.T[Ui480],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding FavoritesOnly}"/><TextBox Text="{Binding VoiceSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.T[Ui481],RelativeSource={RelativeSource AncestorType=Window}}"/></DockPanel><TextBlock Text="{Binding DataContext.T[Ui542],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,4,0,16"/>
<ui:VirtualCardList Cards="{Binding PresetView}" CardHeight="189"><ui:VirtualCardList.CardTemplate><DataTemplate><Button Width="166" Height="175" Padding="0" Margin="0,0,14,14" Command="{Binding DataContext.SelectPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="154"><Grid.RowDefinitions><RowDefinition Height="103"/><RowDefinition Height="55"/></Grid.RowDefinitions><Grid><Ellipse Fill="{DynamicResource AccentSoftBrush}" Width="90" Height="90"/><Ellipse Stroke="{DynamicResource LineBrush}" Width="108" Height="108"/><Path Data="{Binding Icon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="46" Height="46" Stretch="Uniform"/><TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="8" Visibility="{Binding Selected,Converter={StaticResource BoolVisibility}}"/></Grid><StackPanel Grid.Row="1" Margin="12,8"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid></Button></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList>
<WrapPanel><CheckBox Content="{Binding DataContext.T[Ui482],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding FavoritePreset}"/><TextBlock Text="{Binding DataContext.T[Intensity],RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="20,0,8,0"/><Slider Width="180" Value="{Binding VoiceIntensity}" Minimum="0" Maximum="100"/></WrapPanel>
<TextBlock Text="{Binding DataContext.T[Ui573],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,28,0,16"/><ui:VirtualCardList Cards="{Binding AiVoices}" CardHeight="182"><ui:VirtualCardList.CardTemplate><DataTemplate><Button Width="170" Height="168" Margin="0,0,14,14" IsEnabled="{Binding Ready}" Command="{Binding DataContext.UseAiVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><Grid Height="86"><Ellipse Fill="{DynamicResource AccentSoftBrush}" Width="76" Height="76"/><TextBlock Text="AI" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding Cover}" Circular="True" Width="76" Height="76" Stretch="UniformToFill"/></Grid><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="AI Voice · local" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList>
<TextBlock Text="{Binding DataContext.T[Ui483],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,24,0,16"/><ui:VirtualCardList Cards="{Binding DesignedVoices}" CardHeight="182"><ui:VirtualCardList.CardTemplate><DataTemplate><StackPanel><Button Width="172" Height="95" Margin="0,0,12,12" Command="{Binding DataContext.UseDesignedVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel><TextBlock Text="{Binding Name}" FontSize="16"/><TextBlock Text="PRESET · LOCAL" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/></StackPanel></Button><Button Content="{Binding DataContext.T[Ui484],RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Command="{Binding DataContext.ExportPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"/></StackPanel></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList></StackPanel></UserControl>
