<UserControl x:Class="MyVoice.App.Views.VoiceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="CHOISISSEZ VOTRE REGISTRE" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="Créer une voix" Command="{Binding GoVoiceLabCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Voice" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="Le naturel, un personnage, ou une voix que vous avez préparée." Style="{StaticResource MutedText}"/>
<DockPanel Margin="0,16"><CheckBox DockPanel.Dock="Right" Content="Favoris" IsChecked="{Binding FavoritesOnly}"/><TextBox Text="{Binding VoiceSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher une voix classique"/></DockPanel><TextBlock Text="Classic Voices" FontSize="21" Margin="0,4,0,16"/>
<ItemsControl ItemsSource="{Binding PresetView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="166" Height="175" Padding="0" Margin="0,0,14,14" Command="{Binding DataContext.SelectPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="154"><Grid.RowDefinitions><RowDefinition Height="103"/><RowDefinition Height="55"/></Grid.RowDefinitions><Grid><Ellipse Fill="{DynamicResource AccentSoftBrush}" Width="90" Height="90"/><Ellipse Stroke="{DynamicResource LineBrush}" Width="108" Height="108"/><Path Data="{Binding Icon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="46" Height="46" Stretch="Uniform"/><TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="8" Visibility="{Binding Selected,Converter={StaticResource BoolVisibility}}"/></Grid><StackPanel Grid.Row="1" Margin="12,8"><TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel><CheckBox Content="Mettre la voix choisie en favori" IsChecked="{Binding FavoritePreset}"/><TextBlock Text="Intensité" VerticalAlignment="Center" Margin="20,0,8,0"/><Slider Width="180" Value="{Binding VoiceIntensity}" Minimum="0" Maximum="100"/></WrapPanel>
<TextBlock Text="My AI Voices" FontSize="21" Margin="0,28,0,16"/><ItemsControl ItemsSource="{Binding AiVoices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="170" Height="168" Margin="0,0,14,14" IsEnabled="{Binding Ready}" Command="{Binding DataContext.UseAiVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><StackPanel><Grid Height="86"><Ellipse Fill="{DynamicResource AccentSoftBrush}" Width="76" Height="76"/><TextBlock Text="AI" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding Cover}" Circular="True" Width="76" Height="76" Stretch="UniformToFill"/></Grid><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="AI Voice · local" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Mes Voice Presets" FontSize="21" Margin="0,24,0,16"/><ItemsControl ItemsSource="{Binding DesignedVoices}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel><Button Width="172" Height="95" Margin="0,0,12,12" Command="{Binding DataContext.UseDesignedVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="16"/><TextBlock Text="PRESET · LOCAL" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/></StackPanel></Button><Button Content="Exporter" HorizontalAlignment="Left" Command="{Binding DataContext.ExportPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></UserControl>
