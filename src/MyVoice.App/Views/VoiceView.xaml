<UserControl x:Class="MyVoice.App.Views.VoiceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="{Binding DataContext.T[Ui477],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="{Binding DataContext.T[Ui478],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding GoVoiceLabCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="{Binding DataContext.T[Ui602],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="{Binding DataContext.T[Ui479],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/>
<DockPanel Margin="0,16"><CheckBox DockPanel.Dock="Right" Content="{Binding DataContext.T[Ui480],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding FavoritesOnly}"/><TextBox Text="{Binding VoiceSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DataContext.T[Ui481],RelativeSource={RelativeSource AncestorType=Window}}"/></DockPanel><TextBlock Text="{Binding DataContext.T[Ui542],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,4,0,16"/>
<ui:VirtualCardList Cards="{Binding PresetView}" CardHeight="215"><ui:VirtualCardList.CardTemplate><DataTemplate><StackPanel Width="164" Margin="0,0,14,14"><ui:CreationImageButton Style="{StaticResource SelectedVoiceImageButton}" Tag="circle" Command="{Binding DataContext.SelectPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu" AutomationProperties.Name="{Binding DisplayName}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><Grid><Path Data="{Binding Icon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ui:CreationImageButton><TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList>
<WrapPanel><CheckBox Content="{Binding DataContext.T[Ui482],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding FavoritePreset}"/><TextBlock Text="{Binding DataContext.T[Intensity],RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="20,0,8,0"/><Slider Width="180" Value="{Binding VoiceIntensity}" Minimum="0" Maximum="100"/></WrapPanel>
<TextBlock Text="{Binding DataContext.T[Ui573],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,28,0,16"/><ui:VirtualCardList Cards="{Binding AiVoices}" CardHeight="215"><ui:VirtualCardList.CardTemplate><DataTemplate><StackPanel Width="164" Margin="0,0,14,14"><ui:CreationImageButton Style="{StaticResource CreationImageButton}" Tag="circle" IsEnabled="{Binding Ready}" Command="{Binding DataContext.UseAiVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu" AutomationProperties.Name="{Binding Name}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><Grid><ui:CoverImage FilePath="{Binding Cover}" Circular="True" Stretch="UniformToFill"/></Grid></ui:CreationImageButton><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList>
<TextBlock Text="{Binding DataContext.T[Ui483],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="21" Margin="0,24,0,16"/><ui:VirtualCardList Cards="{Binding DesignedVoices}" CardHeight="260"><ui:VirtualCardList.CardTemplate><DataTemplate><StackPanel><StackPanel Width="164" Margin="0,0,14,14"><ui:CreationImageButton Style="{StaticResource CreationImageButton}" Tag="circle" Command="{Binding DataContext.UseDesignedVoiceCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu" AutomationProperties.Name="{Binding Name}"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><Grid><Path Data="M 10,25 L 10,45 M 20,10 L 20,60 M 30,20 L 30,50 M 40,5 L 40,65 M 50,25 L 50,45" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" Width="60" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ui:CreationImageButton><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel><Button Content="{Binding DataContext.T[Ui484],RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Command="{Binding DataContext.ExportPresetCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ContextMenuOpening="OpenMenu"/></StackPanel></DataTemplate></ui:VirtualCardList.CardTemplate></ui:VirtualCardList></StackPanel></UserControl>
