<UserControl x:Class="MyVoice.App.Views.CommunityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:views="clr-namespace:MyVoice.App.Views"><StackPanel><TextBlock Text="CRÉÉ POUR ÊTRE PARTAGÉ" Style="{StaticResource Label}"/><TextBlock Text="Community" Style="{StaticResource Heading}"/><TextBlock Text="Explorez des créations. Gardez vos favoris. Installez pour jouer hors ligne." Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CommunityStatus}" Foreground="{DynamicResource AccentBrush}" Margin="0,18"/><ProgressBar IsIndeterminate="True" Visibility="{Binding CommunityBusy,Converter={StaticResource BoolVisibility}}"/>
<DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="Rechercher" Command="{Binding RefreshCommunityCommand}"/><TextBox Text="{Binding CommunitySearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rechercher Community" ToolTip="Nom de création ou @username"/></DockPanel><WrapPanel><ComboBox Width="190" ItemsSource="{Binding ContentKinds}" SelectedItem="{Binding CommunityKind}"/><ComboBox Width="150" ItemsSource="{Binding ContentSorts}" SelectedItem="{Binding CommunitySort}" Margin="12,5"/><Button Content="Chercher un créateur" Command="{Binding FindCreatorCommand}"/></WrapPanel>
<Border Margin="0,12"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCreator}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding SelectedCreator.DisplayName}" FontSize="22"/><TextBlock Text="{Binding SelectedCreator.Username,StringFormat=@{0}}" Style="{StaticResource MutedText}"/><TextBlock Text="✓ Verified" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding SelectedCreator.Verified,Converter={StaticResource BoolVisibility},FallbackValue=Collapsed}"/><TextBlock Text="{Binding SelectedCreator.Bio}"/><WrapPanel><Button Content="{Binding SelectedCreator.Relationship}" Command="{Binding FollowCreatorCommand}"/><Button Content="Bloquer" Command="{Binding BlockCreatorCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,18"><StackPanel><TextBlock Text="Vos créations auront leur place ici." FontSize="24"/><TextBlock Text="Recherchez une création quand le service est disponible, ou installez un package local. Vos sons et vos voix restent utilisables hors ligne." Style="{StaticResource MutedText}"/><Button Content="Installer un package local" Command="{Binding ImportPackageCommand}" HorizontalAlignment="Left"/></StackPanel></Border><ListBox ItemsSource="{Binding CommunityItems}" SelectedItem="{Binding SelectedCreation}" MaxHeight="470" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="215" Padding="18" Background="{DynamicResource SurfaceBrush}" CornerRadius="16"><StackPanel><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/><TextBlock Text="{Binding Title}" FontSize="19" Margin="0,16,0,8"/><TextBlock Text="{Binding Description}" MaxHeight="62" Style="{StaticResource MutedText}"/><ProgressBar Value="{Binding Progress}" Margin="0,10"/><TextBlock Text="{Binding State}" FontSize="11"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border Margin="0,14"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCreation}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding SelectedCreation.Title}" FontSize="24"/><TextBlock Text="{Binding SelectedCreation.Description}" Style="{StaticResource MutedText}"/><WrapPanel><Button Content="Installer la création" Command="{Binding InstallCommunityCreationCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="♡ Like" Command="{Binding LikeCreationCommand}"/><Button Content="Enregistrer" Command="{Binding SaveCreationCommand}"/><Button Content="Signaler" Command="{Binding ReportCreationCommand}"/></WrapPanel><TextBlock Text="L’installation ajoute une nouvelle copie locale et conserve vos modifications précédentes." Style="{StaticResource MutedText}"/></StackPanel></Border>
<Expander Header="Publier un package préparé dans Studio"><StackPanel><TextBlock Text="Description"/><TextBox Text="{Binding PublishDescription}" MaxLength="2000"/><TextBlock Text="Visibilité"/><ComboBox ItemsSource="{Binding Visibilities}" SelectedItem="{Binding PublishVisibility}"/><CheckBox Content="Je possède les droits de partager tous les fichiers de ce package." IsChecked="{Binding PublishRights}"/><Button Content="Choisir le package et publier" Command="{Binding PublishPackageCommand}" HorizontalAlignment="Left"/><TextBlock Text="Un compte et un email vérifié sont requis. Les AI Voices fondées sur vos références locales ne sont pas exportées." Style="{StaticResource MutedText}"/></StackPanel></Expander>
<Button Content="Installer un package local" Command="{Binding ImportPackageCommand}" HorizontalAlignment="Left"/><TextBlock Text="Aucune création ? Importez vos sons dans Studio ou utilisez vos collections locales." Style="{StaticResource MutedText}"/></StackPanel></UserControl>
