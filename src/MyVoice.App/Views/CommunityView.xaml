<UserControl x:Class="MyVoice.App.Views.CommunityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:MyVoice.App.Services"><StackPanel>
<TextBlock Text="{Binding DataContext.T[Ui300],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}"/><TextBlock Text="{Binding DataContext.T[Ui544],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DataContext.T[Ui301],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}"/>
<DockPanel Margin="0,22,0,12"><Button DockPanel.Dock="Right" Content="{Binding DataContext.T[SearchEverywhere],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshCommunityCommand}"/><TextBox Text="{Binding CommunitySearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rechercher Community" ToolTip="{Binding DataContext.T[Ui302],RelativeSource={RelativeSource AncestorType=Window}}"/></DockPanel>
<WrapPanel><ComboBox Width="180" SelectedValuePath="Tag" SelectedValue="{Binding CommunityKind}"><ComboBoxItem Content="{Binding DataContext.T[Ui535],RelativeSource={RelativeSource AncestorType=Window}}" Tag="all"/><ComboBoxItem Content="{Binding DataContext.T[Ui594],RelativeSource={RelativeSource AncestorType=Window}}" Tag="soundboard"/><ComboBoxItem Content="AI Voices" Tag="ai-voice"/><ComboBoxItem Content="{Binding DataContext.T[Ui605],RelativeSource={RelativeSource AncestorType=Window}}" Tag="voice-preset"/></ComboBox><ComboBox Width="145" ItemsSource="{Binding ContentSorts}" SelectedItem="{Binding CommunitySort}" Margin="12,0"/><Button Content="{Binding DataContext.T[Ui303],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding FindCreatorCommand}"/></WrapPanel>
<TextBlock Text="{Binding CommunityStatus}" Style="{StaticResource MutedText}" Margin="0,14"/><ProgressBar IsIndeterminate="True" Visibility="{Binding CommunityBusy,Converter={StaticResource BoolVisibility}}"/>
<Border Margin="0,12"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding SelectedCreator}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding SelectedCreator.DisplayName}" FontSize="22"/><TextBlock Text="{Binding SelectedCreator.Username,StringFormat=@{0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding SelectedCreator.Bio}"/><WrapPanel><Button Content="{Binding SelectedCreator.Relationship}" Command="{Binding FollowCreatorCommand}"/><Button Content="{Binding DataContext.T[Ui304],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding BlockCreatorCommand}"/></WrapPanel></StackPanel></Border>
<ItemsControl ItemsSource="{Binding CommunityItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Button Width="210" Height="250" Margin="0,0,14,14" Padding="12" Click="Preview" ContextMenuOpening="OpenMenu"><Button.ContextMenu><ContextMenu/></Button.ContextMenu><StackPanel Width="180"><Border Height="140" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"><Grid><TextBlock Text="♪" FontSize="44" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding Cover}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Title}" FontSize="18" Margin="0,12,0,4" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding CreatorLabel}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/></StackPanel></Button>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></UserControl>
