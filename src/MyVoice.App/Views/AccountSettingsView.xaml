<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MyVoice.App.Views.AccountSettingsView">
 <StackPanel>
  <TextBlock Text="{Binding T[SettingsAccount]}" Style="{StaticResource Heading}" />
  <TextBlock Text="{Binding AccountStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
  <Border Style="{StaticResource Card}" Margin="0,0,0,16">
   <StackPanel>
    <CheckBox Content="{Binding T[DiscordPresenceToggle]}" IsChecked="{Binding ShareDiscordPresence}" />
    <TextBlock Text="{Binding T[DiscordPresencePrivacy]}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6" />
    <TextBlock Text="{Binding DiscordPresenceLabel}" Style="{StaticResource MutedText}" />
   </StackPanel>
  </Border>
  <Button Content="{Binding T[AccountOpenSignIn]}" Command="{Binding OpenAccountCommand}" HorizontalAlignment="Left" />
  <StackPanel Margin="20" Visibility="{Binding SignedIn,Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="{Binding DataContext.T[Ui408],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Label}" />
   <TextBlock Text="{Binding ProfileEmail}" FontSize="18" Margin="0,8" />
   <CheckBox Content="{Binding DataContext.T[Ui418],RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding ProfilePrivate}" />
   <Button Content="{Binding DataContext.T[Ui419],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveProfilePrivacyCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding DataContext.T[Ui420],RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" />
   <Expander Header="{Binding DataContext.T[Ui421],RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20">
    <StackPanel>
     <PasswordBox x:Name="NewPassword" Padding="10" />
     <PasswordBox x:Name="NewConfirmation" Padding="10" Margin="0,8" />
     <Button Content="{Binding DataContext.T[Ui422],RelativeSource={RelativeSource AncestorType=Window}}" Click="ChangePassword" />
    </StackPanel>
   </Expander>
   <Button Content="{Binding DataContext.T[RevisionLabel39],RelativeSource={RelativeSource AncestorType=Window}}" Click="RecoverSignedIn" HorizontalAlignment="Left" />
   <Button Content="{Binding DataContext.T[Ui423],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding DataContext.T[Ui424],RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" Margin="0,20,0,8" />
   <Button Content="{Binding DataContext.T[RevisionLabel28],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshSocialCommand}" HorizontalAlignment="Left" />
   <ItemsControl ItemsSource="{Binding SocialContacts}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <StackPanel>
       <TextBlock Text="{Binding Username,StringFormat=@{0}}" />
       <WrapPanel>
        <WrapPanel.Style>
         <Style TargetType="WrapPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
           <DataTrigger Binding="{Binding Kind}" Value="request">
            <Setter Property="Visibility" Value="Visible" />
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </WrapPanel.Style>
        <Button Content="{Binding DataContext.T[RevisionLabel27],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.AcceptFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
        <Button Content="{Binding DataContext.T[RevisionLabel47],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.DeclineFollowCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
       </WrapPanel>
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button Content="{Binding DataContext.T[Ui425],RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DeleteAccountCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="0,24" />
  </StackPanel>
 </StackPanel>
</UserControl>
