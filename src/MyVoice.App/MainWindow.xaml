<Border x:Name="PlayerPanel" Grid.Row="1" Grid.Column="2" Width="270" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding NowPlayingVisible,Converter={StaticResource BoolVisibility}}"><views:NowPlayingView/></Border>
<Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="24" Margin="22,10,22,16"><Grid Margin="20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="74"/><ColumnDefinition Width="240"/><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
<Button Width="42" Height="42" Padding="0" Command="{Binding ToggleMuteCommand}" ToolTip="{Binding MicState}" AutomationProperties.Name="Couper ou réactiver le microphone"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CircleButton}"><Style.Triggers><DataTrigger Binding="{Binding Muted}" Value="True"><Setter Property="Foreground" Value="#FF8B99"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="22" Height="27"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Data="M 7,5 Q 11,1 15,5 L 15,14 Q 11,18 7,14 Z M 3,12 L 3,16 Q 11,25 19,16 L 19,12 M 11,22 L 11,27"/><Path Stroke="#FF8B99" StrokeThickness="2" Data="M 1,2 L 22,25" Visibility="{Binding Muted,Converter={StaticResource BoolVisibility}}"/></Grid></Button>
<StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><Button Content="⏻" Width="40" Height="36" Padding="0" Command="{Binding ToggleVoiceCommand}" ToolTip="Activer les effets vocaux"/><TextBlock Text="Voice FX" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
<Button Grid.Column="2" Command="{Binding QuickSwitchVoiceCommand}" ToolTip="{Binding VoiceSwitchLabel}" Padding="8,4" Margin="10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="154"/></Grid.ColumnDefinitions><Grid><Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Data="M 13,7 Q 18,2 23,7 L 23,19 Q 18,24 13,19 Z M 8,16 L 8,20 Q 18,33 28,20 L 28,16 M 18,28 L 18,33" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding DisplayVoiceCover}" Circular="True" Width="36" Height="36"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayVoice}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding VoiceSwitchLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Grid></Button>
<Button Grid.Column="3" Width="44" Height="44" Padding="7" Style="{StaticResource CircleButton}" Command="{Binding ToggleMonitoringCommand}" ToolTip="Hear Myself" AutomationProperties.Name="Hear Myself"><Grid><Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Data="M 5,11 C 5,0 21,0 21,11 C 21,17 14,17 13,22 C 12,27 6,25 6,21 M 9,11 C 9,6 17,6 17,11 C 17,15 12,14 11,18"/><Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Data="M 25,8 Q 30,13 25,18 M 28,5 Q 36,13 28,21" Visibility="{Binding HearMyself,Converter={StaticResource BoolVisibility}}"/></Grid></Button>
<ProgressBar Grid.Column="4" Value="{Binding OutputMeter}" Margin="20,0" VerticalAlignment="Center" Height="4" ToolTip="Niveau envoyé au microphone virtuel"/>
<Grid Grid.Column="5"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Padding="0" Margin="0,0,8,0" Command="{Binding OpenLastSoundCommand}" ToolTip="Afficher le dernier son"><Grid><TextBlock Text="♪" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:CoverImage FilePath="{Binding LastSoundCover}" Width="40" Height="40" Stretch="UniformToFill"/></Grid></Button><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="LAST SOUND" FontSize="8" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding LastSoundName}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><Button Content="▶ Play" Padding="4,2" Margin="0,4,0,0" Command="{Binding PlayLastSoundCommand}" FontSize="10"/></StackPanel><Button Grid.Column="2" Content="■" Command="{Binding StopAllSoundsCommand}" Padding="3" VerticalAlignment="Center" ToolTip="Arrêter tous les sons"/></Grid>
</Grid></Border>
