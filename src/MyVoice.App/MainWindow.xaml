<Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="18,20,14,20"><StackPanel DockPanel.Dock="Top"><TextBlock Text="VOTRE ESPACE" Style="{StaticResource Label}" Margin="12,4,0,20"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=6,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="6" AutomationProperties.Name="Mic Setup"><StackPanel Orientation="Horizontal"><TextBlock Text="≋" Width="28" FontSize="18"/><TextBlock Text="Mic Setup" FontSize="14" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=7,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="7" AutomationProperties.Name="Profile"><StackPanel Orientation="Horizontal"><TextBlock Text="○" Width="28" FontSize="18"/><TextBlock Text="Profile" FontSize="14" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=3,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="3" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="28" FontSize="18"/><TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center"/></StackPanel></RadioButton></StackPanel><StackPanel><RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=4,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="4" AutomationProperties.Name="Home"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="28" FontSize="18"/><TextBlock Text="Home" FontSize="14" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Style="{StaticResource Nav}" IsChecke