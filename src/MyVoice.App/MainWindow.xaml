<Window x:Class="MyVoice.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MyVoice.App.Views" xmlns:ui="clr-namespace:MyVoice.App.Services" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="MyVoice" Icon="MyVoice.ico" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" Width="1380" Height="920" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
