<Window x:Class="MyVoice.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MyVoice.App.Views" xmlns:ui="clr-namespace:MyVoice.App.Services" Title="MyVoice" Icon="MyVoice.ico" Background="#1C1D20" Foreground="#E8E4DB" FontFamily="Segoe UI" FontSize="13" Width="1340" Height="920" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
<Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#161719" BorderBrush="#363638" BorderThickness="0,0,1,0"><DockPanel Margin="18,28,18,16">
  <StackPanel DockPanel.Dock="Top"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="MyVoice.ico" Width="28" Height="28"/><TextBlock Grid.Column="1" Text="MyVoice" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/></Grid><TextBlock Text="PERSONAL AUDIO STUDIO" FontSize="9" Foreground="#777873" Margin="0,10,0,38"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#333438" Margin="0,0,0,15"/><TextBlock Text="ENGINE" Style="{StaticResource Label}"/><TextBlock Text="{Binding AiState}" Foreground="#E0AD62" FontSize="12" Margin="0,0,0,14"/><Button Content="{Binding T[Exit]}" Click="ExitClick"/><TextBlock Text="{Binding ApplicationVersion}" Foreground="#656663" FontSize="10" Margin="0,16,0,0"/></StackPanel>
  <StackPanel><TextBlock Text="WORKSPACE" Style="{StaticResource Label}"/><RadioButton Style="{StaticResource Nav}" Content="{Binding T[Voice]}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=0,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="0"/><RadioButton Style="{StaticResource Nav}" Content="{Binding T[Soundboard]}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=1,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="1"/><RadioButton Style="{StaticResource Nav}" Content="{Binding T[Lab]}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=2,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="2"/><Border Height="1" Background="#333438" Margin="0,22"/><RadioButton Style="{StaticResource Nav}" Content="{Binding T[Settings]}" IsChecked="{Binding Page,Converter={StaticResource PageMatch},ConverterParameter=3,Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="3"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,26,28,18"><Grid x:Name="PageHost"><Grid.LayoutTransform><ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/></Grid.LayoutTransform>
  <views:MicrophoneView><views:MicrophoneView.Style><Style TargetType="views:MicrophoneView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:MicrophoneView.Style></views:MicrophoneView>
  <views:SoundboardView><views:SoundboardView.Style><Style TargetType="views:SoundboardView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:SoundboardView.Style></views:SoundboardView>
  <views:VoiceLabView><views:VoiceLabView.Style><Style TargetType="views:VoiceLabView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:VoiceLabView.Style></views:VoiceLabView>
  <views:SettingsView><views:SettingsView.Style><Style TargetType="views:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:SettingsView.Style></views:SettingsView>
 </Grid></ScrollViewer><Border Grid.Row="1" BorderBrush="#353638" BorderThickness="0,1,0,0" Padding="20,9"><TextBlock Text="{Binding Status}" Foreground="#A9A79F" FontSize="11" MaxHeight="42"/></Border></Grid>
 <Border x:Name="PlayerPanel" Grid.Column="2" Width="270" BorderBrush="#363638" BorderThickness="1,0,0,0" Background="#202124" Visibility="{Binding NowPlayingVisible,Converter={StaticResource BoolVisibility}}"><views:NowPlayingView/></Border>
 <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#252628" BorderBrush="#4C463A" BorderThickness="1" CornerRadius="20" Margin="18,10,18,14"><Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="92"/><ColumnDefinition Width="210"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding MicState}" FontSize="10"/><Button Content="{Binding T[Mute]}" Command="{Binding ToggleMuteCommand}" Padding="9,5" HorizontalAlignment="Left"/></StackPanel>
 <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Button Width="42" Height="42" Content="⏻" Command="{Binding ToggleVoiceCommand}" Style="{StaticResource CircleButton}" ToolTip="{Binding T[VoicePowerTip]}"/><TextBlock Text="Voice FX" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
 <Button Grid.Column="2" Command="{Binding QuickSwitchVoiceCommand}" Padding="10,5" ToolTip="{Binding T[QuickVoiceTip]}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions><Path Stroke="#E0AD62" StrokeThickness="2" Data="M 13,7 Q 18,2 23,7 L 23,19 Q 18,24 13,19 Z M 8,16 L 8,20 Q 18,33 28,20 L 28,16 M 18,28 L 18,33" VerticalAlignment="Center"/><ui:CoverImage Source="{Binding DisplayVoiceCover}" Width="36" Height="36" Circular="True"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayVoice}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding VoiceSwitchLabel}" FontSize="10" Foreground="#A8A296"/></StackPanel></Grid></Button>
 <StackPanel Grid.Column="3" HorizontalAlignment="Center"><Button Width="42" Height="42" Command="{Binding ToggleMonitoringCommand}" Style="{StaticResource CircleButton}" ToolTip="{Binding T[HearMyself]}"><Grid Width="24" Height="26"><Path Stroke="#E0AD62" StrokeThickness="1.8" Data="M 5,10 C 5,-1 23,-1 23,11 C 23,18 16,18 15,23 C 14,28 7,26 7,21 M 10,11 C 10,5 18,5 18,11 C 18,15 13,14 12,18"/><Path Stroke="#E0AD62" StrokeThickness="2.5" Data="M 2,2 L 24,26"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HearMyself}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid></Button><CheckBox IsChecked="{Binding HearMyself}" Content="Monitor" FontSize="10" Margin="0"/></StackPanel>
 <StackPanel Grid.Column="4" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="{Binding RouteStatus}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><ProgressBar Value="{Binding OutputMeter}" Margin="0,10,0,0"/></StackPanel>
 <Button Grid.Column="5" Command="{Binding OpenLastSoundCommand}" ToolTip="{Binding T[LastSound]}"><Grid Width="90"><ui:CoverImage Source="{Binding LastSoundCover}" Stretch="UniformToFill" Opacity="0.3"/><StackPanel VerticalAlignment="Center"><TextBlock Text="LAST SOUND" FontSize="8" Foreground="#D2B785"/><TextBlock Text="{Binding LastSoundName}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel></Grid></Button>
 <Button Grid.Column="6" Content="■" Command="{Binding StopAllSoundsCommand}" ToolTip="{Binding T[StopAll]}" Padding="8" VerticalAlignment="Center"/>
 </Grid></Border>
</Grid></Window>
